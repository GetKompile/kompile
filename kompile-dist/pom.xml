<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.kompile</groupId>
        <artifactId>kompile</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-dist</artifactId>
    <packaging>pom</packaging>
    <name>Kompile :: Distribution</name>
    <description>
        Curated end-to-end platform distribution. Bundles all GraalVM native images
        (CLIs, main RAG server, subprocess types, app-lite), kompile-sdk-serving,
        shared libraries (libkompile_pipelines, libkompile_c_library), and the
        kompile-python sdx_runtime wheel into a single platform-specific archive.

        Activated by -Dkompile.dist=true at the reactor root.
    </description>

    <properties>
        <!-- May also be supplied directly as -Dkompile.sdx.assets.dir=... -->
        <kompile.sdx.assets.dir>${env.KOMPILE_SDX_ASSETS_DIR}</kompile.sdx.assets.dir>
        <kompile.distribution.variant>full</kompile.distribution.variant>
        <kompile.cuda.version>12.9</kompile.cuda.version>
        <kompile.sdk.classifier>${javacpp.platform}${javacpp.platform.extension}</kompile.sdk.classifier>
        <kompile.distribution.classifier>${kompile.distribution.variant}-${kompile.distribution.platform.classifier}</kompile.distribution.classifier>
    </properties>

    <!--
        Reactor-ordering dependencies. Declaring these forces Maven to build
        every upstream module that contributes an artifact to the distribution
        before kompile-dist itself is assembled. The dependencies are pom-typed
        so they do not pull anything onto the classpath (kompile-dist has no
        compiled code of its own).
    -->
    <dependencies>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-cli</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-agent-cli</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-cli</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-model-cli</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-component-cli</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-main</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
        <!-- JVM worker for JavaScript/Python SCRIPT steps. The app-main native image contains
             only its lightweight client; GraalJS/Truffle remain inside this exec JAR. -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-compute-graph-scripting</artifactId>
            <version>${project.version}</version>
            <classifier>exec</classifier>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-lite</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
        <!--
            The end-user persona apps: chat (:8081) and the crawl manager (:8082).
            Product persona JVM fallbacks use the exec classifier so the
            maven-dependency-plugin can stage the fat jars for the assembly.

            These are not optional extras. kompile-app-main is the admin console now and
            no longer mounts the chat or crawl APIs at all, so a dist that ships only
            kompile-server has no chat and no crawl manager in it. See
            docs/architecture/app-persona-boundary.md.
        -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-chat</artifactId>
            <version>${project.version}</version>
            <classifier>exec</classifier>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-crawl-manager</artifactId>
            <version>${project.version}</version>
            <classifier>exec</classifier>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-sdk-serving</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-pipelines-framework-runtime</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Build the non-Maven components (kompile-c-library via CMake and
                the kompile-python wheel via setuptools) in prepare-package,
                so they are on disk before the assembly runs.

                Both depend on libkompile_pipelines.so, which is produced by
                kompile-pipelines-framework-runtime's native-library profile —
                and that module is ordered before kompile-dist via the
                pom dependency declared above.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>build-c-library</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <workingDirectory>${project.parent.basedir}/kompile-c-library</workingDirectory>
                            <arguments>
                                <argument>rebuild-and-link.sh</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-python-wheel</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <!-- kompile-python is an optional, currently-untracked module. Build its
                                 wheel only when setup.py is present, and never fail the dist build when
                                 it is absent (e.g. a clean CI checkout where kompile-python/ is not
                                 present at all). Any prebuilt wheel already in kompile-python/dist/ is
                                 still bundled as-is by the python fileSet in dist.xml. -->
                            <executable>bash</executable>
                            <workingDirectory>${project.parent.basedir}</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>d="kompile-python"; if [ -f "$d/setup.py" ]; then ( cd "$d" &amp;&amp; python3 setup.py bdist_wheel ); else echo "kompile-python: no setup.py found, skipping optional Python wheel build"; fi</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Copy the separately-launched JVM product services from the local Maven
                repository. Local MCP model workers are native-only and are staged by
                stage-portable-binaries.sh instead.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-scripting-worker-exec-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>ai.kompile</groupId>
                                    <artifactId>kompile-compute-graph-scripting</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>exec</classifier>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/scripting-deps</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <!--
                        Same staging step for the two end-user persona apps, into their own
                        persona-deps/ directory. Kept as a separate execution rather than two
                        more artifactItems above so the output directory name stays honest
                        about what it holds.
                    -->
                    <execution>
                        <id>copy-persona-exec-jars</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>ai.kompile</groupId>
                                    <artifactId>kompile-app-chat</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>exec</classifier>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/persona-deps</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>ai.kompile</groupId>
                                    <artifactId>kompile-app-crawl-manager</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>exec</classifier>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/persona-deps</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Stage side-loaded natives through the same platform/flavor-strict helper used by
                build-dist.sh. The helper emits one canonical flat lib/ layout, rejects conflicting
                basenames, and applies the requested optimized ND4J flavor only after the baseline
                platform set. This prevents foreign classifiers and baseline/AVX2 ambiguity from
                leaking into the Maven-only distribution route.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>stage-complete-sdx-sdk</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="bash" failonerror="true">
                                    <arg value="${project.basedir}/src/main/build/stage-sdx-assets.sh"/>
                                    <arg value="${kompile.sdx.assets.dir}"/>
                                    <arg value="${project.build.directory}/sdx-sdk"/>
                                    <arg value="${kompile.distribution.variant}"/>
                                    <arg value="${javacpp.platform}"/>
                                    <arg value="${nd4j.version}"/>
                                    <arg value="${kompile.cuda.version}"/>
                                    <arg value="${nd4j.backend}"/>
                                    <arg value="${kompile.sdk.classifier}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <!--
                        Copy native-image outputs into target/portable-bin and normalize only those
                        staged copies. This makes the Maven assembly obey the same ELF interpreter
                        and $ORIGIN/../lib RUNPATH contract as build-dist.sh without modifying any
                        producing module's target directory.
                    -->
                    <execution>
                        <id>stage-portable-binaries</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="bash" failonerror="true">
                                    <arg value="${project.basedir}/src/main/build/stage-portable-binaries.sh"/>
                                    <arg value="${project.basedir}/.."/>
                                    <arg value="${project.build.directory}/portable-bin"/>
                                    <arg value="${project.basedir}/src/main/build/normalize-elf-portability.sh"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-native-libs</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/native-libs" quiet="true"/>
                                <mkdir dir="${project.build.directory}/native-libs"/>
                                <exec executable="bash" failonerror="true">
                                    <arg value="${project.basedir}/src/main/build/stage-native-libs.sh"/>
                                    <arg value="${project.basedir}/../kompile-app/kompile-app-parent/kompile-app-main/target/native-libs"/>
                                    <arg value="${project.build.directory}/native-libs"/>
                                    <arg value="${javacpp.platform}"/>
                                    <arg value="${javacpp.platform.extension}"/>
                                    <arg value="${nd4j.backend}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build the distribution archive -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>create-distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/assembly/dist.xml</descriptor>
                            </descriptors>
                            <finalName>kompile-dist-${project.version}</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
