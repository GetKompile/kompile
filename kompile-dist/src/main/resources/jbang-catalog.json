    "kompile": {
      "script-ref": "lib/kompile-cli.jar",
      "description": "Kompile CLI — project scaffold, crawl, chat, and admin commands",
      "java": "17+",
      "java-options": [
        "-Dfile.encoding=UTF-8"
      ]
    },
    "kompile-server": {
      "script-ref": "lib/kompile-server.jar",
