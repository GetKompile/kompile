<!-- NOTE: build-dist.sh is the release variant orchestrator. Maven prepare-package stages
     native executables through the same portability normalizer before this descriptor reads
     target/portable-bin, so both packaging routes enforce the native archive contract. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
                              http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>${kompile.distribution.classifier}</id>
    <formats>
        <format>zip</format>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>kompile-${project.version}</baseDirectory>

    <files>
        <!-- ============ CLI native executables (renamed for friendlier UX) ============ -->
        <file>
            <source>${project.build.directory}/portable-bin/kompile</source>
            <outputDirectory>bin</outputDirectory>
            <destName>kompile</destName>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/portable-bin/kompile-agent</source>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/portable-bin/kompile-app-cli</source>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/portable-bin/kompile-model</source>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/portable-bin/kompile-component</source>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </file>

        <!-- ============ kompile-app-main: unified server binary ============
             The `kompile-server` binary handles both the main RAG server and all
             subprocess types (ingest, vector-population, embedding, model-init,
             vlm-test, training) via the subprocess-type flag. See
             MainApplication.main() for the routing logic. -->
        <file>
            <source>${project.build.directory}/portable-bin/kompile-server</source>
            <outputDirectory>bin</outputDirectory>
            <destName>kompile-server</destName>
            <fileMode>0755</fileMode>
        </file>

        <!-- ============ kompile-sdk-serving shaded JAR (Vert.x OpenAI-compatible server) ============ -->
        <file>
            <source>${project.parent.basedir}/kompile-app/kompile-middleware/kompile-sdk-serving/target/kompile-sdk-serving-${project.version}-shaded.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>kompile-sdk-serving.jar</destName>
        </file>

        <!-- ============ kompile-model-staging Spring Boot exec JAR ============
             The staging service runs as a separate Spring Boot process on port 8090.
             It is shipped as the Spring Boot fat (exec) jar by default; the launcher
             script `bin/kompile-model-staging.sh` will auto-prefer a native binary
             at `bin/kompile-model-staging` if one is later added. The exec jar is
             copied into ${project.build.directory}/staging-deps by the
             maven-dependency-plugin (see kompile-dist/pom.xml). -->
        <file>
            <source>${project.build.directory}/staging-deps/kompile-model-staging-${project.version}-exec.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>kompile-model-staging.jar</destName>
        </file>

        <!-- ============ Persona app Spring Boot exec JARs ============
             The end-user apps: chat on :8081, the crawl manager on :8082. kompile-app-main
             is the admin console and no longer mounts the chat or crawl APIs, so without
             these two a dist has no end-user surface at all — they are not optional extras.
             Same shipping shape as the staging service above: exec jar on every build, plus
             a GraalVM binary in bin/ on -Dkompile.dist builds (see the persona fileSets
             below). The launcher scripts `bin/kompile-chat.sh` / `bin/kompile-crawl-manager.sh`
             prefer the binary and fall back to this jar. Staged into
             ${project.build.directory}/persona-deps by the maven-dependency-plugin
             (see kompile-dist/pom.xml). -->
        <file>
            <source>${project.build.directory}/persona-deps/kompile-app-chat-${project.version}-exec.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>kompile-chat.jar</destName>
        </file>
        <file>
            <source>${project.build.directory}/persona-deps/kompile-app-crawl-manager-${project.version}-exec.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>kompile-crawl-manager.jar</destName>
        </file>

        <!-- ============ kompile-server exec JAR (JBang/jar fallback) ============
             Produced by kompile-app-main's repackage-exec execution, which runs in both
             the `native` profile (kompile.dist) and the `uber` profile (kompile.uber).
             jbang-catalog.json points every server/subprocess alias at this jar; the
             unified subprocess flag works identically on jar and native binary. -->
        <file>
            <source>${project.parent.basedir}/kompile-app/kompile-app-parent/kompile-app-main/target/kompile-app-main-${project.version}-exec.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>kompile-server.jar</destName>
        </file>

        <!-- ============ JavaScript/Python scripting worker exec JAR ============
             app-main contains only the native-safe NodeExecutor client. The worker is launched
             with the bundled Java runtime and owns the GraalJS/Truffle/Python implementation. -->
        <file>
            <source>${project.build.directory}/scripting-deps/kompile-compute-graph-scripting-${project.version}-exec.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>kompile-scripting-worker.jar</destName>
        </file>

        <!-- ============ kompile-cli shaded JAR (JBang/jar fallback) ============
             Attached by the kompile-cli-main shade plugin on every package. -->
        <file>
            <source>${project.parent.basedir}/kompile-cli/kompile-cli-main/target/kompile-cli-main-${project.version}-shaded.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>kompile-cli.jar</destName>
        </file>

        <!-- ============ JBang catalog and quick-start guide (at archive root) ============
             These files always exist (checked into src/main/resources). -->
        <file>
            <source>${project.basedir}/src/main/resources/jbang-catalog.json</source>
            <outputDirectory></outputDirectory>
            <destName>jbang-catalog.json</destName>
        </file>
        <file>
            <source>${project.basedir}/src/main/resources/JBANG.md</source>
            <outputDirectory></outputDirectory>
            <destName>JBANG.md</destName>
        </file>
    </files>

    <fileSets>
        <!-- Complete DL4J companion SDK, validated and staged by the POM. -->
        <fileSet>
            <directory>${project.build.directory}/sdx-sdk</directory>
            <outputDirectory>sdx-sdk</outputDirectory>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>

        <!-- ============ GraalVM-generated Java runtime shared libs ============
             stage-portable-binaries.sh de-duplicates the shims emitted beside each image;
             they must ship in bin/ beside the service executables for runtime loading. -->
        <fileSet>
            <directory>${project.build.directory}/portable-bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>lib*.so</include>
                <include>lib*.dylib</include>
                <include>lib*.dll</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- ============ Side-loaded JavaCPP / ND4J native libraries ============
             The native images intentionally exclude these files. prepare-package invokes the same
             strict staging helper as build-dist.sh, so this directory contains only the requested
             OS/architecture and CPU flavor in the canonical flat lib/ layout. Omitting this makes
             archives boot only when a user cache happens to contain the same libraries. -->
        <fileSet>
            <directory>${project.build.directory}/native-libs</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>*.so</include>
                <include>*.so.*</include>
                <include>*.dylib</include>
                <include>*.dll</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- ============ Optional extra subprocess native images (vlm-test, training) ============
             These are only emitted when their opt-in profiles are explicitly
             activated. The fileSet pattern lets them be skipped silently when
             absent, which is what we want for a default dist build. -->
        <fileSet>
            <directory>${project.build.directory}/portable-bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>kompile-vlm-test</include>
                <include>kompile-training</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- ============ Optional kompile-model-staging native binary ============
             If the staging module has been built with `-Pnative`, the resulting
             `kompile-model-staging` binary is picked up here. When absent, the
             launcher script falls back to the Spring Boot exec JAR shipped at
             lib/kompile-model-staging.jar. -->
        <fileSet>
            <directory>${project.build.directory}/portable-bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>kompile-model-staging</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- ============ Persona app native binaries ============
             Emitted by each persona's `native` profile, which -Dkompile.dist activates —
             the same trigger app-main uses. Both forms ship: the binary here and the exec
             jar in lib/ above, so the launchers can prefer the binary and fall back.
             The fileSet pattern still matches nothing on a plain (non-dist) build, which
             is what leaves the jar-only path working.

             The native profile sets imageName to the DIST name (kompile-chat,
             kompile-crawl-manager) rather than the artifactId. An assembly fileSet cannot
             rename, so a binary built as `kompile-app-chat` would land in bin/ under a
             different name here than build-dist.sh gives it, and the launcher would find
             it on one dist path and not the other. Matching the names up front is what
             keeps the two dist builders honest.

             The GraalVM-emitted JDK shims (libjava.so, libjvm.so, ...) are already de-duplicated
             in portable-bin and picked up by the shared-library fileSet above. -->
        <fileSet>
            <directory>${project.build.directory}/portable-bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>kompile-chat</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.build.directory}/portable-bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>kompile-crawl-manager</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- ============ Optional kompile-app-lite native binary ============
             Built when the kompile-app-lite native profile is activated.
             When absent (the default), no native binary is present; users can
             run the exec jar directly with java -jar. -->
        <fileSet>
            <directory>${project.build.directory}/portable-bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>kompile-app-lite</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- ============ GraalVM shared library + generated headers ============ -->
        <fileSet>
            <directory>${project.parent.basedir}/kompile-app/kompile-data/kompile-pipelines-framework/kompile-pipelines-framework-runtime/target</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>libkompile_pipelines.so</include>
                <include>libkompile_pipelines.dylib</include>
                <include>libkompile_pipelines.dll</include>
                <include>graal_isolate.h</include>
                <include>graal_isolate_dynamic.h</include>
                <include>libkompile_pipelines.h</include>
                <include>libkompile_pipelines_dynamic.h</include>
            </includes>
        </fileSet>

        <!-- ============ kompile-c-library (CMake-built C wrapper) ============ -->
        <fileSet>
            <directory>${project.parent.basedir}/kompile-c-library</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>libkompile_c_library.so</include>
                <include>libkompile_c_library.dylib</include>
                <include>libkompile_c_library.dll</include>
            </includes>
        </fileSet>

        <!-- ============ kompile-python sdx_runtime wheel ============ -->
        <fileSet>
            <directory>${project.parent.basedir}/kompile-python/dist</directory>
            <outputDirectory>python</outputDirectory>
            <includes>
                <include>*.whl</include>
            </includes>
        </fileSet>

        <!-- ============ Launcher scripts (wrapper for the Vert.x JAR) ============ -->
        <fileSet>
            <directory>${project.basedir}/src/main/scripts</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>*.sh</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- ============ Default application configuration ============ -->
        <fileSet>
            <directory>${project.parent.basedir}/kompile-app/kompile-app-parent/kompile-app-main/src/main/resources</directory>
            <outputDirectory>conf</outputDirectory>
            <includes>
                <include>application.properties</include>
                <include>application-*.properties</include>
                <include>log4j2*.xml</include>
                <include>log4j2.component.properties</include>
            </includes>
        </fileSet>

        <!-- ============ Empty runtime directories ============ -->
        <fileSet>
            <directory>${project.basedir}/src/main/assembly</directory>
            <outputDirectory>data</outputDirectory>
            <excludes>
                <exclude>**/*</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/src/main/assembly</directory>
            <outputDirectory>logs</outputDirectory>
            <excludes>
                <exclude>**/*</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/src/main/assembly</directory>
            <outputDirectory>models</outputDirectory>
            <excludes>
                <exclude>**/*</exclude>
            </excludes>
        </fileSet>
    </fileSets>
</assembly>
