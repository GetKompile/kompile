# kompile CodeBuild configuration.
# Copy this file OUTSIDE the repository (it will hold account-specific values):
#   cp aws/codebuild/parameters.env.example ~/.config/kompile-codebuild.env
# Fill the REQUIRED block, then provision everything in one go:
#   aws/codebuild/scripts/aws/provision.sh ~/.config/kompile-codebuild.env build
# Every empty value below is either derived automatically (buckets, registry,
# image URIs, fleet ARNs) or disables the lane that needs it. provision.sh
# appends derived values to generated-codebuild.env next to this file.

## ---------------------------------------------------------------- REQUIRED
AWS_REGION=
# Clone URL CodeBuild fetches for kompile, and the ref containing aws/codebuild
SOURCE_LOCATION=
KOMPILE_REF=
# DL4J source and default ref (override per build with start-build.sh)
DL4J_REPOSITORY=
DL4J_REF=
# linux-x86_64 tar.gz archives baked into the build images
GRAALVM_ARCHIVE_URL=
JDK11_ARCHIVE_URL=

## ------------------------------------------------- NAMING (derived if empty)
STACK_PREFIX=kompile
PROJECT_PREFIX=kompile
ARTIFACT_BUCKET=
CACHE_BUCKET=
ECR_REGISTRY=
ECR_REPOSITORY=
# ECR repository for published kompile spin images (cli/app-main/model-staging)
SPIN_REPOSITORY=
# Image for the privileged kompile-spins lane (curated: has docker)
SPINS_IMAGE=

## ------------------------------------------------------------- SOURCE MODE
# github (default): CodeBuild clones SOURCE_LOCATION@KOMPILE_REF (must be
#   pushed). s3: builds a zip of your LOCAL tracked tree uploaded to the
#   private artifact bucket — use when the branch cannot be pushed (WIP
#   features, private data on a public repo). Webhooks/seed re-provision
#   do not apply in s3 mode; rerun provision/release to ship changes.
SOURCE_MODE=github
# Space-separated path prefixes stripped from the uploaded source
SOURCE_EXCLUDES="dist/ .codebuild/"

## ------------------------------------------------------------- TARGET SCOPE
# Space/comma-separated allowlist of targets to deploy/start; empty = all of
# the requested kind. Names are the keys in targets.yml.
ENABLED_TARGETS=
# Spin flavors published by release.sh (space list of source build targets)
RELEASE_SPIN_TARGETS=linux-x86_64
# Branch whose pushes auto-start every deployed target (webhook). Needs
# GitHub credentials with admin:repo_hook on SOURCE_LOCATION imported into
# CodeBuild (set-github-token.sh); empty = builds start manually.
WEBHOOK_BRANCH=

## ------------------------------------------- SOURCE ACCESS (private repos)
# Secrets Manager secret ids holding GitHub PATs. Create/rotate with:
#   scripts/aws/set-github-token.sh CONFIG <secret-id>   (reads token on stdin)
GITHUB_TOKEN_SECRET=
DL4J_TOKEN_SECRET=

## --------------------------------------------------------------- PUBLISHING
# Dist artifacts always upload to
#   s3://$ARTIFACT_BUCKET/$RELEASE_PREFIX/<release-tag-or-commit>/<target>/
RELEASE_PREFIX=releases
# owner/repo for GitHub Release uploads (empty = S3 only). Needs a token
# secret with `contents: write`, and builds started with a release tag.
GITHUB_RELEASE_REPO=
GITHUB_RELEASE_TOKEN_SECRET=

## -------------------------------------------------------------- BUILD KNOBS
DL4J_BUILD_THREADS=12
DL4J_EXTRA_MAVEN_ARGS=
DL4J_MAVEN_OPTS=-Xmx8g
MAVEN_TEST_ARGS=
RUN_TESTS_PROFILES=-Pcpu
RUN_TESTS_MODULES=platform-tests
CUDA_COMPUTE_CAPABILITIES="8.6 9.0"
# CUDA toolkit/deps version used by GPU validation targets
CUDA_VERSION=12.9
ZLUDA_TARGET=rdna3
NATIVE_PARALLELISM=4
KOMPILE_MAVEN_OPTS=-Xmx16g

## -------------------------------------------------- ON-DEMAND COMPUTE SIZES
# GraalVM native-image wants the big boxes; shrink these to save money.
LINUX_COMPUTE_TYPE=BUILD_GENERAL1_2XLARGE
ARM_COMPUTE_TYPE=BUILD_GENERAL1_2XLARGE
GPU_COMPUTE_TYPE=BUILD_GENERAL1_SMALL
WINDOWS_COMPUTE_TYPE=BUILD_GENERAL1_LARGE
MACOS_COMPUTE_TYPE=BUILD_GENERAL1_MEDIUM
# Per-lane overrides (default to LINUX_COMPUTE_TYPE)
CUDA_BUILD_COMPUTE_TYPE=
AMD_BUILD_COMPUTE_TYPE=
ANDROID_COMPUTE_TYPE=
TPU_COMPUTE_TYPE=
HEXAGON_COMPUTE_TYPE=
LINUX_EC2_COMPUTE_TYPE=

## -------------------------------------------------------------- IMAGE INPUTS
# arm64 archives enable the linux-arm64 image (built with docker buildx + QEMU)
GRAALVM_ARM_ARCHIVE_URL=
JDK11_ARM_ARCHIVE_URL=
# Android NDK pin, direct-downloaded from dl.google.com (mirrors DL4J)
ANDROID_NDK_VERSION=r27d
# Base images for the CUDA build images (one per supported CUDA line)
CUDA_13_1_BASE_IMAGE=nvidia/cuda:13.1.2-cudnn-devel-ubuntu24.04
CUDA_12_9_BASE_IMAGE=nvidia/cuda:12.9.1-cudnn-devel-ubuntu22.04
# AMD image: ROCm base plus a CUDA toolkit for ZLUDA compilation.
# ZLUDA bootstraps automatically from the pinned vosen/ZLUDA release tag
# (mirrors DL4J's workflow); the URL is an override, empty version disables.
ROCM_BASE_IMAGE=rocm/dev-ubuntu-22.04:6.4-complete
ZLUDA_VERSION=v6
ZLUDA_ARCHIVE_URL=
# TPU image: optional PJRT plugin download (libtpu .so)
PJRT_PLUGIN_URL=
# Hexagon builds need NO SDK (hexagon-mlir is BSD-3; runtime is dlopen'd).
# Optional archive for on-device tooling only.
HEXAGON_SDK_ARCHIVE_URL=

## -------------------------------- IMAGE URIS (derived from ECR when empty)
LINUX_IMAGE=
LINUX_ARM_IMAGE=
ANDROID_IMAGE=
CUDA_12_6_IMAGE=
CUDA_12_9_IMAGE=
AMD_IMAGE=
TPU_IMAGE=
HEXAGON_IMAGE=
# Windows container image cannot be built from Linux; either bake a Windows
# EC2 fleet AMI (preferred, see FLEETS) or supply a container image URI here.
WINDOWS_IMAGE=
WINDOWS_CUDA_IMAGE=
# Defaults to the curated aws/codebuild/macos-arm-base:14 when empty
MACOS_IMAGE=
# Free-form host for run-tests-matrix
CONFIGURABLE_IMAGE=
CONFIGURABLE_ENVIRONMENT_TYPE=
CONFIGURABLE_BUILD_SPEC=
CONFIGURABLE_COMPUTE_TYPE=
CONFIGURABLE_FLEET_ARN=

## ----------------------- FLEETS (reserved capacity; created when configured)
# Fleets bill for provisioned capacity continuously — enable only what you
# use and tear down with teardown.sh. macOS: BUILD_GENERAL1_MEDIUM (M2, 24 GB)
# or BUILD_GENERAL1_LARGE (M2, 32 GB); MAC_ARM regions: us-east-1, us-east-2,
# us-west-2, ap-southeast-2 (+ eu-central-1 for MEDIUM).
MACOS_FLEET_COMPUTE=
MACOS_AMI_ID=
MACOS_CAPACITY=1
# Windows lanes run on WINDOWS_EC2 fleets with a toolchain AMI:
#   scripts/aws/bake-ami.sh CONFIG windows [--cuda]
WINDOWS_INSTANCE_TYPE=
WINDOWS_AMI_ID=
WINDOWS_CAPACITY=1
WINDOWS_CUDA_INSTANCE_TYPE=
WINDOWS_CUDA_AMI_ID=
WINDOWS_CUDA_CAPACITY=1
# AMD GPU smoke tests: LINUX_EC2 fleet whose AMI carries ROCm/ZLUDA drivers
#   scripts/aws/bake-ami.sh CONFIG linux-accelerator --base-ami ... --sdk-script ...
AMD_GPU_INSTANCE_TYPE=
AMD_GPU_AMI_ID=
AMD_GPU_CAPACITY=1
# Optional reserved NVIDIA GPU fleet (validation defaults to on-demand GPU)
GPU_FLEET_COMPUTE=
GPU_CAPACITY=1
# Optional big reserved Linux/ARM container fleets (default: on-demand)
LINUX_FLEET_COMPUTE=
LINUX_FLEET_CAPACITY=1
ARM_FLEET_COMPUTE=
ARM_FLEET_CAPACITY=1
# TPU/Hexagon smoke tests need hardware AWS does not sell; point these at
# self-managed fleets to enable, otherwise those two targets skip.
TPU_HW_FLEET_ARN=
HEXAGON_HW_FLEET_ARN=
# Pre-existing fleet ARNs (set to reuse instead of creating)
MACOS_FLEET_ARN=
WINDOWS_FLEET_ARN=
WINDOWS_CUDA_FLEET_ARN=
AMD_GPU_FLEET_ARN=
GPU_FLEET_ARN=
LINUX_FLEET_ARN=
ARM_FLEET_ARN=

## ------------------------------------------ TOOL PATHS INSIDE IMAGES / AMIS
JAVA11_HOME=/opt/jdk11
GRAALVM_HOME=/opt/graalvm
WINDOWS_JAVA11_HOME='C:\opt\jdk11'
WINDOWS_GRAALVM_HOME='C:\opt\graalvm'
ANDROID_NDK_HOME=/opt/android-ndk
ROCM_HOME=/opt/rocm
ZLUDA_HOME=/opt/zluda
PJRT_LIBRARY_PATH=/opt/pjrt/libtpu.so
HEXAGON_SDK_ROOT=/opt/hexagon
IMAGE_PULL_CREDENTIALS_TYPE=SERVICE_ROLE
