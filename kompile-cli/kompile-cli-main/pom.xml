    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>kompile.dist</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <!-- Native payloads are never embedded in a Graal image. Unpack every
                         runtime dependency's native members, then select and flatten only
                         the current platform into target/lib for both direct execution and
                         distribution packaging. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-native-payloads</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>unpack-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/native-libs</outputDirectory>
                                    <includeTypes>jar</includeTypes>
                                    <includes>**/*.so,**/*.so.*,**/*.dylib,**/*.dll,**/shared-runtime-manifest.txt</includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>stage-native-payloads</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../../kompile-dist/src/main/build/stage-native-libs.sh</argument>
                                        <argument>${project.build.directory}/native-libs</argument>
                                        <argument>${project.build.directory}/lib</argument>
                                        <argument>${javacpp.platform}</argument>
                                        <argument>${javacpp.platform.extension}</argument>
                                        <argument>none</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                            <execution>
                                <id>test-native</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <phase>test</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>ai.kompile.cli.main.MainCommand</mainClass>
                            <imageName>${project.artifactId}</imageName>
                            <buildArgs combine.children="append">
                                <buildArg>-J-Xmx18g</buildArg>
                                <buildArg>--verbose</buildArg>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>--allow-incomplete-classpath</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>-H:DeadlockWatchdogInterval=30</buildArg>
                                <buildArg>-H:+DeadlockWatchdogExitOnTimeout</buildArg>
                                <buildArg>--enable-url-protocols=https,http</buildArg>
                                <buildArg>-Dorg.bytedeco.javacpp.logger.debug=true</buildArg>
                                <buildArg>-Dorg.bytedeco.javacpp.nopointergc=true</buildArg>
                                <buildArg>--initialize-at-run-time=io.netty.channel.epoll.Epoll</buildArg>
                                <buildArg>--initialize-at-run-time=org.bytedeco.javacpp</buildArg>
                                <buildArg>--initialize-at-run-time=org.eclipse.deeplearning4j</buildArg>
                                <buildArg>--initialize-at-run-time=org.nd4j</buildArg>
                                <buildArg>--initialize-at-run-time=com.sun.jna.Native</buildArg>
                                <buildArg>--initialize-at-run-time=org.jline</buildArg>
                                <buildArg>--initialize-at-run-time=org.eclipse.jgit.util.FS</buildArg>
                                <buildArg>--initialize-at-run-time=org.eclipse.jgit.internal.storage.file.WindowCache</buildArg>
                                <buildArg>--initialize-at-run-time=org.eclipse.jgit.transport.HttpAuthMethod</buildArg>
                                <buildArg>--initialize-at-run-time=org.eclipse.jgit.nls.GlobalBundleCache</buildArg>
                                <buildArg>--initialize-at-build-time=org.sqlite.util.ProcessRunner</buildArg>
                                <buildArg>-H:+AllowDeprecatedBuilderClassesOnImageClasspath</buildArg>
                                <buildArg>-H:IncludeResources=cli-agents\.json</buildArg>
                                <buildArg>-H:IncludeResources=pi-mcp-adapter/.*</buildArg>
                                <buildArg>-H:IncludeResources=version\.properties</buildArg>
                                <buildArg>-H:IncludeResources=kompile-cli-versions\.properties</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/native-image/.*\.json</buildArg>
                                <buildArg>-H:IncludeResources=ai/kompile/.*\.schema\.json</buildArg>
                                <buildArg>-H:IncludeResources=ai/kompile/cli/main/chat/providers/.*\.json</buildArg>
                                <buildArg>-H:IncludeResources=${native.nd4j.config.pattern}</buildArg>
                                <buildArg>-H:IncludeResources=${native.bytedeco.metadata.pattern}</buildArg>
                                <!-- JNI/backend binaries are loaded from the distribution lib/ tree. -->
                                <buildArg>-H:ExcludeResources=${native.exclude.platform.payload}</buildArg>
                                <buildArg>-H:ExcludeResources=${native.exclude.library.payload}</buildArg>
                                <buildArg>-H:IncludeResources=org/apache/pdfbox/resources/afm/.*</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/services/.*</buildArg>
                                <buildArg>-H:IncludeResources=org/jline/.*</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/services/org/jline/.*</buildArg>
                                <buildArg>-H:IncludeResources=build-scripts/.*\.sh</buildArg>
                                <!-- Bulk-register lsp4j protocol POJOs for gson reflective (de)serialization. -->
                                <buildArg>--features=ai.kompile.cli.main.lsp.graal.Lsp4jFeature</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>bundle-pi-mcp-adapter</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/pi-mcp-adapter-build"/>
                                        <exec executable="${npm.executable}"
                                              dir="${project.build.directory}/pi-mcp-adapter-build"
                                              failifexecutionfails="true"
                                              failonerror="true">
                                            <arg value="--prefix"/>
                                            <arg value="${project.build.directory}/pi-mcp-adapter-build"/>
                                            <arg value="install"/>
                                            <arg value="--no-save"/>
                                            <arg value="--omit=dev"/>
                                            <arg value="pi-mcp-adapter@2.21.0"/>
                                        </exec>
                                        <mkdir dir="${project.build.directory}/generated-pi-mcp-adapter/pi-mcp-adapter"/>
                                        <zip destfile="${project.build.directory}/generated-pi-mcp-adapter/pi-mcp-adapter/adapter.zip">
                                            <zipfileset dir="${project.build.directory}/pi-mcp-adapter-build/node_modules/pi-mcp-adapter"/>
                                            <zipfileset dir="${project.build.directory}/pi-mcp-adapter-build/node_modules"
                                                        prefix="node_modules"/>
                                        </zip>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>windows-npm</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <properties>
                <npm.executable>npm.cmd</npm.executable>
            </properties>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>version.properties</exclude>
                    <exclude>kompile-cli-versions.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>version.properties</include>
                    <include>kompile-cli-versions.properties</include>
                </includes>
            </resource>
            <!-- Release/native builds add the complete pi-mcp-adapter archive here. -->
            <resource>
                <directory>${project.build.directory}/generated-pi-mcp-adapter</directory>
                <filtering>false</filtering>
            </resource>
            <!-- Bundle build-scripts/ as classpath resources for extraction at runtime -->
            <resource>
                <directory>${kompile.root.dir}/build-scripts</directory>
                <targetPath>build-scripts</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>*.sh</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Registry gate: the packaged cli-agents.json comes from the kompile-app-core
                 jar RESOLVED at build time (reactor or ~/.m2), so a stale or gutted jar
                 silently ships an agent-locked CLI even when the source tree is correct
                 (this happened 2026-07-11: a codex-only registry was installed to ~/.m2).
                 Extract the resolved registry and fail unless the full roster is present.
                 Bound to package so the reactor's kompile-app-core jar has been packaged
                 before dependency:unpack runs; this keeps compile/test reactor builds valid
                 while still gating every packaged jar/native distribution, including -DskipTests.
                 Roster changes must also update kompile-app-core's gate and
                 CliAgentRegistryTest. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>extract-resolved-cli-agent-registry</id>
                        <phase>package</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>ai.kompile</groupId>
                                    <artifactId>kompile-app-core</artifactId>
                                    <version>${project.version}</version>
                                    <includes>cli-agents.json</includes>
                                    <outputDirectory>${project.build.directory}/cli-agents-gate</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <overWriteReleases>true</overWriteReleases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>verify-resolved-cli-agent-roster</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <condition property="cliAgentsRosterComplete">
                                    <and>
                                        <resourcecontains resource="${project.build.directory}/cli-agents-gate/cli-agents.json" substring="&quot;claude-cli&quot;"/>
                                        <resourcecontains resource="${project.build.directory}/cli-agents-gate/cli-agents.json" substring="&quot;codex-cli&quot;"/>
                                        <resourcecontains resource="${project.build.directory}/cli-agents-gate/cli-agents.json" substring="&quot;gemini-cli&quot;"/>
                                        <resourcecontains resource="${project.build.directory}/cli-agents-gate/cli-agents.json" substring="&quot;opencode-cli&quot;"/>
                                        <resourcecontains resource="${project.build.directory}/cli-agents-gate/cli-agents.json" substring="&quot;qwen-cli&quot;"/>
                                        <resourcecontains resource="${project.build.directory}/cli-agents-gate/cli-agents.json" substring="&quot;pi-cli&quot;"/>
                                    </and>
                                </condition>
                                <fail unless="cliAgentsRosterComplete">The cli-agents.json resolved from the kompile-app-core jar is missing part of the required agent roster (claude-cli, codex-cli, gemini-cli, opencode-cli, qwen-cli, pi-cli). The kompile-app-core artifact in the reactor/~/.m2 is stale or was built from a gutted registry. Rebuild it from a correct tree first: mvn -f kompile-app/kompile-app-parent/kompile-app-core/pom.xml install -DskipTests. If the roster is genuinely changing, update this gate, kompile-app-core's gate, and CliAgentRegistryTest in the same commit.</fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>generateManPages</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includeProjectDependencies>true</includeProjectDependencies>
                    <includePluginDependencies>true</includePluginDependencies>
                    <mainClass>picocli.codegen.docgen.manpage.ManPageGenerator</mainClass>
                    <arguments>
                        <argument>--outdir=${project.build.directory}/generated-picocli-docs</argument>
                        <argument>-v</argument>
                        <argument>--template-dir=src/docs/mantemplates</argument>
                        <argument>ai.kompile.cli.main.MainCommand</argument>
                        <argument>ai.kompile.cli.main.Bootstrap</argument>
                        <argument>ai.kompile.cli.main.Info</argument>
                        <argument>ai.kompile.cli.main.build.BuildMain</argument>
                        <argument>ai.kompile.cli.main.build.CloneBuildComponents</argument>
                        <argument>ai.kompile.cli.main.build.GenerateImageAndSDK</argument>
                        <argument>ai.kompile.cli.main.build.NativeImageBuilder</argument>
                        <argument>ai.kompile.cli.main.build.PipelineCommandGenerator</argument>
                        <argument>ai.kompile.cli.main.build.PomGenerator</argument>
                        <argument>ai.kompile.cli.main.build.RagPomGenerator</argument>
                        <argument>ai.kompile.cli.main.build.BuildAppCommand</argument>
                        <argument>ai.kompile.cli.main.build.generators.SampleProjectSync</argument>
                        <argument>ai.kompile.cli.main.config.ConfigMain</argument>
                        <argument>ai.kompile.cli.main.exec.ExecMain</argument>
                        <argument>ai.kompile.cli.main.exec.InferenceServerCreate</argument>
                        <argument>ai.kompile.cli.main.exec.PipelineGenerator</argument>
                        <argument>ai.kompile.cli.main.exec.SequencePipelineCombiner</argument>
                        <argument>ai.kompile.cli.main.exec.NewStepCreator</argument> <argument>ai.kompile.cli.main.install.InstallAll</argument>
                        <argument>ai.kompile.cli.main.install.InstallGraalvm</argument>
                        <argument>ai.kompile.cli.main.install.InstallMain</argument>
