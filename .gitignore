# Kompile runtime metadata
.kompile/
**/.kompile/

# State the stack writes when it is run against the repo checkout itself. Generated projects
# (kompile-fpna-v*) keep their own copies of these and those ARE tracked — the rules below are
# root-anchored so they only exclude the dev box's working state, not a project's contents.
# config/ holds oauth-encryption.key, which must never reach a commit.
/config/
/log-archives/
/anserini/
/fact-sheets/

# Per-project OAuth encryption keys, generated at project init. Ten of these are already tracked
# from earlier generated projects; this rule stops any new one from being added.
oauth-encryption.key

# Local reproduction harness: a CMakeLists hardcoding an absolute libnd4j path plus its build trees.
/cuda-cleanup-concurrency-contract/

# Mobile distribution build output (~718M) and one-off debug screenshots.
kompile-chat-local/mobile/build/
/mobile-graph-before.png

