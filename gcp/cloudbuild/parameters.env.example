# kompile Cloud Build (GCP) configuration — TPU workloads.
# Copy OUTSIDE the repository:
#   cp gcp/cloudbuild/parameters.env.example ~/.config/kompile-cloudbuild-gcp.env
# Fill the REQUIRED block, then:
#   gcp/cloudbuild/scripts/provision.sh ~/.config/kompile-cloudbuild-gcp.env
# Empty values are derived (buckets, registry, image URI) or disable a lane.
# Derived values append to generated-cloudbuild-gcp.env beside this file.

## ---------------------------------------------------------------- REQUIRED
GCP_PROJECT_ID=
# Region for Artifact Registry / GCS / Cloud Build
GCP_REGION=us-central1
# Zone with the TPU capacity you want; check with:
#   gcloud compute tpus accelerator-types list --zone <zone>
TPU_ZONE=
# DL4J source and default ref (override per build)
DL4J_REPOSITORY=
DL4J_REF=
# linux-x86_64 tar.gz archives baked into the builder image
GRAALVM_ARCHIVE_URL=
JDK11_ARCHIVE_URL=

## ---------------------------------------------------------------- TPU LANE
# Accelerator for smoke tests (v5litepod-1 is the cheapest single-chip v5e)
TPU_ACCELERATOR_TYPE=v5litepod-1
TPU_RUNTIME_VERSION=tpu-ubuntu2204-base
# Hard ceiling on TPU VM lifetime inside a smoke run (seconds)
TPU_SMOKE_TIMEOUT=7200

## ------------------------------------------------- NAMING (derived if empty)
NAME_PREFIX=kompile
ARTIFACT_BUCKET=
AR_REPOSITORY=
BUILDER_IMAGE=
SERVICE_ACCOUNT_EMAIL=

## -------------------------------------------------------------- BUILD KNOBS
DL4J_BUILD_THREADS=12
DL4J_MAVEN_OPTS=-Xmx8g
MAVEN_TEST_ARGS=
# Cloud Build machine type for the build lane (E2_HIGHCPU_32 = 32 vCPU/32GB).
# For more RAM create a private worker pool and set WORKER_POOL instead.
MACHINE_TYPE=E2_HIGHCPU_32
WORKER_POOL=
# Build the kompile distribution after the DL4J TPU backend
BUILD_KOMPILE=true
KOMPILE_VARIANT=cli-only
NATIVE_PARALLELISM=4
KOMPILE_MAVEN_OPTS=-Xmx16g

## --------------------------------------------------------------- PUBLISHING
# Dist always uploads to gs://$ARTIFACT_BUCKET/$RELEASE_PREFIX/<tag-or-adhoc>/<target>/
RELEASE_PREFIX=releases
# owner/repo for GitHub Release uploads (empty = GCS only); token lives in
# Secret Manager under GITHUB_RELEASE_TOKEN_SECRET (the wizard stores it).
GITHUB_RELEASE_REPO=
GITHUB_RELEASE_TOKEN_SECRET=
