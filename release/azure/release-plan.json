      "os": "linux",
      "architecture": "x86_64",
      "worker": "worker.sh",
      "workloads": ["maven", "sdk", "distribution"],
      "build": {
        "kind": "platform",
        "backend": "cpu",
        "javacppPlatform": "linux-x86_64",
        "dl4jLane": "linux-x86_64-cpu",
        "variants": [
          {"name": "base", "classifier": "linux-x86_64"},
          {"name": "avx2", "classifier": "linux-x86_64-avx2"},
          {"name": "avx512", "classifier": "linux-x86_64-avx512"},
          {"name": "onednn", "classifier": "linux-x86_64-onednn"},
          {"name": "onednn-avx2", "classifier": "linux-x86_64-onednn-avx2"},
          {"name": "onednn-avx512", "classifier": "linux-x86_64-onednn-avx512"},
