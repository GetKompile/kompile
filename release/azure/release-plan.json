{
  "schemaVersion": 2,
  "provider": "azure",
  "projectTag": "kompile-release",
  "artifactContainer": "releases",
  "repositoryContainer": "maven",
  "controlContainer": "control",
  "artifactPrefix": "kompile/releases",
  "mavenRepositoryPrefix": "kompile/releases/maven-repository",
  "unsupportedWorkflows": {
    "macos": "Azure has no macOS VM offering; retain the AWS dedicated-host lane for macosx-arm64."
  },
  "buildCoverage": {
    "distributionVariants": ["cli-only", "full"],
    "publishingPolicy": "maven-assemblies-to-azure-blob"
  },
  "defaults": {
    "rootVolumeGiB": 1024,
    "mavenHeapGiB": 48,
    "buildThreads": 64,
    "maxCores": 72,
    "maxTotalCores": 288,
    "x86MachineCandidates": [
      "Standard_F72s_v2",
      "Standard_F64s_v2",
      "Standard_D64ds_v5",
      "Standard_F48s_v2",
      "Standard_F32s_v2"
    ],
    "armMachineCandidates": [
      "Standard_D64ps_v5",
      "Standard_D48ps_v5",
      "Standard_D32ps_v5"
    ],
    "linuxImage": "Canonical:0001-com-ubuntu-server-jammy:22_04-lts-gen2:latest",
    "windowsImage": "MicrosoftWindowsServer:WindowsServer:2022-datacenter-g2:latest"
  },
  "shards": [
    {
      "id": "distribution-cli-only-linux-x86_64",
      "os": "linux",
      "architecture": "x86_64",
      "worker": "worker.sh",
      "workloads": ["maven", "distribution"],
      "build": {
        "kind": "distribution",
        "backend": "none",
        "javacppPlatform": "linux-x86_64",
        "variants": [
          {
            "name": "cli-only",
            "distributionClassifier": "cli-only-linux-x86_64",
            "requireSdk": false
          }
        ]
      }
    },
    {
      "id": "distribution-cli-only-linux-arm64",
      "os": "linux",
      "architecture": "arm64",
      "worker": "worker.sh",
      "workloads": ["maven", "distribution"],
      "build": {
        "kind": "distribution",
        "backend": "none",
        "javacppPlatform": "linux-arm64",
        "variants": [
          {
            "name": "cli-only",
            "distributionClassifier": "cli-only-linux-arm64",
            "requireSdk": false
          }
        ]
      }
    },
    {
      "id": "distribution-cli-only-windows-x86_64",
      "os": "windows",
      "architecture": "x86_64",
      "worker": "worker.ps1",
      "workloads": ["maven", "distribution"],
      "build": {
        "kind": "distribution",
        "backend": "none",
        "javacppPlatform": "windows-x86_64",
        "variants": [
          {
            "name": "cli-only",
            "distributionClassifier": "cli-only-windows-x86_64",
            "requireSdk": false
          }
        ]
      }
    },
    {
