{
  "schemaVersion": 1,
  "description": "Per-classifier JVM (--jars-only) distributions built by .github/workflows/build-java-distributions.yml on standard GitHub-hosted runners and uploaded to R2 under kompile/releases/<version>/java/<distributionClassifier>/. The classifiers are exactly KOMPILE_PLATFORMS in build-scripts/build-common.sh, in the same order; java_matrix.py derives every build argument from the resolvers in that file and the backend profiles in the root pom.xml.",
  "runners": {
    "linux-x86_64": "ubuntu-22.04",
    "linux-arm64": "ubuntu-24.04-arm",
    "windows-x86_64": "windows-2022",
    "macosx-arm64": "macos-14"
  },
  "blockedReasons": {
    "android": "Android classifiers ship as APK/AAR builds, not as a desktop JVM distribution.",
    "dl4j-cuda-line": "The DL4J release shards named for this CUDA line build CUDA 12.9, so no nd4j backend for this line is published.",
    "zluda-without-rocm": "DL4J publishes ZLUDA only with a ROCm qualifier (zluda-rocm-<version>)."
  },
  "classifiers": [
    {"classifier": "linux-x86_64", "variant": "full"},
    {"classifier": "linux-x86_64-avx2", "variant": "full"},
    {"classifier": "linux-x86_64-avx512", "variant": "full"},
