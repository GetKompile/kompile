    {"classifier": "linux-arm64", "variant": "full"},
    {"classifier": "linux-arm64-armcompute", "variant": "full"},
    {"classifier": "linux-arm64-onednn", "variant": "full"},
    {"classifier": "linux-arm64-compile", "variant": "full"},
