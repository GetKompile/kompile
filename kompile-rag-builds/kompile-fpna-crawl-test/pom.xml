<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.kompile</groupId>
    <artifactId>kompile</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>kompile-fpna-crawl-test</artifactId>
  <name>Kompile FP&amp;A Direct Crawl Tests</name>
  <description>Standalone JUnit harness for controlled FP&amp;A model and crawl testing</description>

  <properties>
    <kompile.version>${project.version}</kompile.version>
    <surefire.excludedGroups>fpna-model,fpna-full-crawl</surefire.excludedGroups>
    <fpna.test.heap>24g</fpna.test.heap>
    <fpna.test.offheap.bytes>34359738368</fpna.test.offheap.bytes>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>ai.kompile</groupId>
        <artifactId>kompile-app</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-app-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-crawl-graph</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-app-crawl-svc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-evaluation</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-knowledge-graph</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-process-discovery</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-app-ontology</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-app-llm-pipeline</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-embedding-anserini</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-vectorstore-anserini</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-chat-local-core</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>samediff-llm</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>nd4j-ggml</artifactId>
      <version>${nd4j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>${nd4j.backend}</artifactId>
      <version>${nd4j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>${nd4j.backend}</artifactId>
      <version>${nd4j.version}</version>
      <classifier>${javacpp.platform}</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>tokenizers-native</artifactId>
      <version>${nd4j.version}</version>
      <classifier>${javacpp.platform}</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-loader-excel</artifactId>
      <version>${kompile.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-loader-tika</artifactId>
      <version>${kompile.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-loader-web</artifactId>
      <version>${kompile.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Match the production model-staging runtime contract for CUDA evaluations:
       the selected CUDA backend remains primary while nd4j-native is present for
       BackendManager's normal CPU fallback. This selects no GPU ordinal. -->
  <profiles>
    <profile>
      <id>cuda-dual-backend</id>
      <activation>
        <property>
          <name>kompile.cuda</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-native</artifactId>
          <version>${nd4j.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-native</artifactId>
          <version>${nd4j.version}</version>
          <classifier>${javacpp.platform}</classifier>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <!-- Explicitly enabling the LFM25 model test must also include its fpna-model tag.
         Keep model-backed tests excluded for ordinary test runs, but make
         -Dkompile.fpna.lfm25.enabled=true sufficient to exercise this test. -->
    <profile>
      <id>lfm25-model-test</id>
      <activation>
        <property>
          <name>kompile.fpna.lfm25.enabled</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <surefire.excludedGroups>fpna-full-crawl</surefire.excludedGroups>
      </properties>
    </profile>
    <!-- Keep the 50M graph-evidence test opt-in while making its enabling property sufficient. -->
    <profile>
      <id>supra50m-model-test</id>
      <activation>
        <property>
          <name>kompile.fpna.supra50m.enabled</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <surefire.excludedGroups>fpna-full-crawl</surefire.excludedGroups>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
          <forkCount>1</forkCount>
          <reuseForks>false</reuseForks>
          <shutdown>kill</shutdown>
          <enableProcessChecker>all</enableProcessChecker>
          <forkedProcessTimeoutInSeconds>3600</forkedProcessTimeoutInSeconds>
          <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
          <argLine>-Xmx${fpna.test.heap} -Dorg.bytedeco.javacpp.maxphysicalbytes=${fpna.test.offheap.bytes}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>${maven-install-plugin.version}</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
