<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Fatal JavaCPP/SDX failures stay inside this private runtime worker. -->
        <service
            android:name=".model.SdxRuntimeService"
            android:exported="false"
            android:process=":sdx_model_runtime"
            android:stopWithTask="false" />

        <!--
            Qualcomm FastRPC is supplied by a compatible device's vendor image.
            Declaring it admits the system library into this flavor's linker
            namespace; the project-owned DSP skeleton remains bundled in the APK.
        -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="true" />
    </application>

</manifest>
