<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.kompile</groupId>
    <artifactId>kompile-chat-local</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>kompile-chat-local-mobile</artifactId>
  <packaging>pom</packaging>
  <name>kompile-chat-local-mobile</name>
  <description>Profile-gated Android accelerator APK and offline bundle lifecycle</description>

  <properties>
    <exec-maven-plugin.version>3.3.0</exec-maven-plugin.version>

    <mobile.android.sdk>${env.ANDROID_SDK_ROOT}</mobile.android.sdk>
    <mobile.android.ndk>${env.ANDROID_NDK_ROOT}</mobile.android.ndk>
    <mobile.java.home>${java.home}</mobile.java.home>
    <mobile.maven>${maven.home}/bin/mvn</mobile.maven>
    <mobile.dl4j.root>${project.basedir}/../../../deeplearning4j</mobile.dl4j.root>
    <mobile.examples.root>${project.basedir}/../../../deeplearning4j-examples</mobile.examples.root>

    <mobile.output.dir>${project.build.directory}/offline-dist</mobile.output.dir>
    <mobile.bundle>${project.build.directory}/kompile-offline-graph-chat-full.zip</mobile.bundle>
    <mobile.apk.vulkan>${mobile.output.dir}/kompile-offline-graph-chat-vulkan.apk</mobile.apk.vulkan>
    <mobile.apk.hexagon>${mobile.output.dir}/kompile-offline-graph-chat-hexagon.apk</mobile.apk.hexagon>
    <mobile.apk.tensor.g3>${mobile.output.dir}/kompile-offline-graph-chat-tensor-g3-pixel-8a.apk</mobile.apk.tensor.g3>
    <mobile.apk.tensor.g5>${mobile.output.dir}/kompile-offline-graph-chat-tensor-g5.apk</mobile.apk.tensor.g5>

    <mobile.aar.vulkan>${mobile.dl4j.root}/libnd4j/build/mobile/vulkan/dist/sdx-runtime-android-arm64-vulkan.aar</mobile.aar.vulkan>
    <mobile.aar.hexagon>${mobile.dl4j.root}/libnd4j/build/mobile/hexagon/dist/sdx-runtime-android-arm64-hexagon.aar</mobile.aar.hexagon>
    <mobile.aar.tensor.g3>${mobile.dl4j.root}/libnd4j/build/mobile/tensor-g3/dist/sdx-runtime-android-arm64-tensor-g3.aar</mobile.aar.tensor.g3>
    <mobile.aar.tensor.g5>${mobile.dl4j.root}/libnd4j/build/mobile/google-tensor-g5/dist/sdx-chat-runtime-android-arm64-google-tensor-g5.aar</mobile.aar.tensor.g5>

    <mobile.graph.module>${project.basedir}/../../kompile-app/kompile-data/kompile-graphs/kompile-graph-reasoning-local</mobile.graph.module>
    <mobile.graph.sdk>${mobile.graph.module}/target/kompile-graph-reasoning-local-0.1.0-SNAPSHOT-native-sdk.zip</mobile.graph.sdk>
    <mobile.graph.android.library>${mobile.graph.module}/target/android-aot/jni/arm64-v8a/libkompile_reasoning_android.so</mobile.graph.android.library>
    <mobile.graph.javacpp.library>${project.basedir}/android/app/src/main/jniLibs/arm64-v8a/libjnikompile_graph.so</mobile.graph.javacpp.library>
    <mobile.graph.header>${mobile.graph.module}/include/kompile_reasoning.h</mobile.graph.header>

    <mobile.canonical.sdz>${mobile.examples.root}/sdx-runtime-examples/models/mlp.sdz</mobile.canonical.sdz>
    <mobile.canonical.sdz.readme>${mobile.examples.root}/sdx-runtime-examples/models/README.md</mobile.canonical.sdz.readme>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>validate-mobile-profile</id>
            <phase>validate</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>cmake</executable>
              <arguments>
                <argument>-DVARIANT=${kompile.mobile}</argument>
                <argument>-DANDROID_SDK=${mobile.android.sdk}</argument>
                <argument>-DANDROID_NDK=${mobile.android.ndk}</argument>
                <argument>-DJAVA_HOME_DIR=${mobile.java.home}</argument>
                <argument>-DMAVEN_EXECUTABLE=${mobile.maven}</argument>
                <argument>-DMAVEN_OFFLINE=${settings.offline}</argument>
                <argument>-DDL4J_ROOT=${mobile.dl4j.root}</argument>
                <argument>-P</argument>
                <argument>${project.basedir}/cmake/ValidateMobileProfile.cmake</argument>
              </arguments>
            </configuration>
          </execution>

          <execution>
            <id>assemble-mobile-apk</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>${project.basedir}/android/tools/build-offline-accelerators.sh</argument>
                <argument>--variant</argument>
                <argument>${kompile.mobile}</argument>
                <argument>--vulkan-aar</argument>
                <argument>${mobile.aar.vulkan}</argument>
                <argument>--hexagon-aar</argument>
                <argument>${mobile.aar.hexagon}</argument>
                <argument>--tensor-g3-aar</argument>
                <argument>${mobile.aar.tensor.g3}</argument>
                <argument>--tensor-g5-aar</argument>
                <argument>${mobile.aar.tensor.g5}</argument>
                <argument>--graph-library</argument>
                <argument>${mobile.graph.android.library}</argument>
                <argument>--android-sdk</argument>
                <argument>${mobile.android.sdk}</argument>
                <argument>--android-ndk</argument>
                <argument>${mobile.android.ndk}</argument>
                <argument>--java-home</argument>
                <argument>${mobile.java.home}</argument>
                <argument>--maven</argument>
                <argument>${mobile.maven}</argument>
                <argument>--output</argument>
                <argument>${mobile.output.dir}</argument>
              </arguments>
              <environmentVariables>
                <DL4J_ROOT>${mobile.dl4j.root}</DL4J_ROOT>
                <SOURCE_DATE_EPOCH>0</SOURCE_DATE_EPOCH>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>mobile-all-bundle</id>
      <activation>
        <property>
          <name>kompile.mobile</name>
          <value>all</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>package-mobile-bundle</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>${project.basedir}/package-offline-graph-chat.sh</argument>
                    <argument>--output</argument>
                    <argument>${mobile.bundle}</argument>
                    <argument>--dl4j-root</argument>
                    <argument>${mobile.dl4j.root}</argument>
                    <argument>--examples-root</argument>
                    <argument>${mobile.examples.root}</argument>
                    <argument>--vulkan-apk</argument>
                    <argument>${mobile.apk.vulkan}</argument>
                    <argument>--hexagon-apk</argument>
                    <argument>${mobile.apk.hexagon}</argument>
                    <argument>--tensor-g3-apk</argument>
                    <argument>${mobile.apk.tensor.g3}</argument>
                    <argument>--tensor-g5-apk</argument>
                    <argument>${mobile.apk.tensor.g5}</argument>
                    <argument>--vulkan-aar</argument>
                    <argument>${mobile.aar.vulkan}</argument>
                    <argument>--hexagon-aar</argument>
                    <argument>${mobile.aar.hexagon}</argument>
                    <argument>--tensor-g3-aar</argument>
                    <argument>${mobile.aar.tensor.g3}</argument>
                    <argument>--tensor-g5-aar</argument>
                    <argument>${mobile.aar.tensor.g5}</argument>
                    <argument>--graph-sdk</argument>
                    <argument>${mobile.graph.sdk}</argument>
                    <argument>--android-graph-library</argument>
                    <argument>${mobile.graph.android.library}</argument>
                    <argument>--android-graph-javacpp-library</argument>
                    <argument>${mobile.graph.javacpp.library}</argument>
                    <argument>--graph-header</argument>
                    <argument>${mobile.graph.header}</argument>
                    <argument>--canonical-sdz</argument>
                    <argument>${mobile.canonical.sdz}</argument>
                    <argument>--canonical-sdz-readme</argument>
                    <argument>${mobile.canonical.sdz.readme}</argument>
                  </arguments>
                  <environmentVariables>
                    <SOURCE_DATE_EPOCH>0</SOURCE_DATE_EPOCH>
                  </environmentVariables>
                </configuration>
              </execution>

              <execution>
                <id>verify-mobile-bundle</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>${project.basedir}/verify-offline-graph-chat-bundle.sh</argument>
                    <argument>--bundle</argument>
                    <argument>${mobile.bundle}</argument>
                    <argument>--android-sdk</argument>
                    <argument>${mobile.android.sdk}</argument>
                    <argument>--android-ndk</argument>
                    <argument>${mobile.android.ndk}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
