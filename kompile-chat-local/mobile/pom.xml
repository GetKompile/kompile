<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.kompile</groupId>
    <artifactId>kompile-chat-local</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>kompile-chat-local-mobile</artifactId>
  <packaging>pom</packaging>
  <name>kompile-chat-local-mobile</name>
  <description>Profile-gated Android accelerator APK and offline bundle lifecycle</description>

  <properties>
    <exec-maven-plugin.version>3.3.0</exec-maven-plugin.version>

    <mobile.android.sdk>${env.ANDROID_SDK_ROOT}</mobile.android.sdk>
    <mobile.android.ndk>${env.ANDROID_NDK_ROOT}</mobile.android.ndk>
    <mobile.java.home>${java.home}</mobile.java.home>
    <mobile.dl4j.root>${project.basedir}/../../../deeplearning4j</mobile.dl4j.root>
    <mobile.examples.root>${mobile.dl4j.root}/nd4j/sdx-runtime-examples</mobile.examples.root>

    <mobile.output.dir>${project.build.directory}/offline-dist</mobile.output.dir>
    <mobile.bundle>${project.build.directory}/kompile-offline-graph-chat-full.zip</mobile.bundle>
    <mobile.apk.vulkan>${mobile.output.dir}/kompile-offline-graph-chat-vulkan.apk</mobile.apk.vulkan>
    <mobile.apk.hexagon>${mobile.output.dir}/kompile-offline-graph-chat-hexagon.apk</mobile.apk.hexagon>
    <mobile.apk.tensor.g3>${mobile.output.dir}/kompile-offline-graph-chat-tensor-g3-pixel-8a.apk</mobile.apk.tensor.g3>
    <mobile.apk.tensor.g5>${mobile.output.dir}/kompile-offline-graph-chat-tensor-g5.apk</mobile.apk.tensor.g5>

    <!-- Maven is the artifact boundary. Retained scripts receive only these target-local paths. -->
    <mobile.sdx.version>${nd4j.version}</mobile.sdx.version>
    <mobile.artifact.stage>${project.build.directory}/maven-artifacts</mobile.artifact.stage>
    <mobile.graph.unpack>${project.build.directory}/graph-android-arm64</mobile.graph.unpack>
    <mobile.android.jni>${project.build.directory}/android-jni/arm64-v8a</mobile.android.jni>

    <mobile.aar.vulkan>${mobile.artifact.stage}/nd4j-sdx-${mobile.sdx.version}-android-arm64-vulkan.aar</mobile.aar.vulkan>
    <mobile.aar.hexagon>${mobile.artifact.stage}/nd4j-sdx-${mobile.sdx.version}-android-arm64-hexagon.aar</mobile.aar.hexagon>
    <mobile.aar.tensor.g3>${mobile.artifact.stage}/nd4j-sdx-${mobile.sdx.version}-android-arm64-tensor-g3.aar</mobile.aar.tensor.g3>
    <mobile.aar.tensor.g5>${mobile.artifact.stage}/nd4j-sdx-litertlm-${mobile.sdx.version}-android-arm64-google-tensor-g5.aar</mobile.aar.tensor.g5>

    <mobile.graph.sdk>${mobile.artifact.stage}/kompile-graph-reasoning-local-${project.version}-android-arm64.zip</mobile.graph.sdk>
    <mobile.graph.android.library>${mobile.graph.unpack}/jni/arm64-v8a/libkompile_reasoning_android.so</mobile.graph.android.library>
    <mobile.graph.javacpp.library>${mobile.android.jni}/libjnikompile_graph.so</mobile.graph.javacpp.library>
    <mobile.graph.header>${mobile.graph.unpack}/include/kompile_reasoning.h</mobile.graph.header>
    <mobile.graph.verifier>${mobile.graph.unpack}/bin/verify-android-ndk.sh</mobile.graph.verifier>
    <mobile.javacpp.jar>${mobile.artifact.stage}/javacpp-${javacpp.version}.jar</mobile.javacpp.jar>

    <mobile.canonical.sdz>${mobile.examples.root}/fixture/src/main/resources/models/mlp.sdz</mobile.canonical.sdz>
    <mobile.canonical.sdz.readme>${mobile.examples.root}/fixture/src/main/resources/contracts/mlp-fixture.md</mobile.canonical.sdz.readme>
  </properties>

  <dependencies>
    <!-- Explicit reactor edge: Gradle consumes this from Maven local during the outer install. -->
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-chat-local-core</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>ai.kompile</groupId>
      <artifactId>kompile-graph-reasoning-local</artifactId>
      <version>${project.version}</version>
      <classifier>android-arm64</classifier>
      <type>zip</type>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
      <version>${javacpp.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>stage-mobile-maven-artifacts</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${mobile.artifact.stage}</outputDirectory>
              <excludeTransitive>true</excludeTransitive>
              <useBaseVersion>true</useBaseVersion>
            </configuration>
          </execution>
          <execution>
            <id>unpack-graph-android-sdk</id>
            <phase>initialize</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.kompile</groupId>
                  <artifactId>kompile-graph-reasoning-local</artifactId>
                  <version>${project.version}</version>
                  <classifier>android-arm64</classifier>
                  <type>zip</type>
                  <outputDirectory>${mobile.graph.unpack}</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>validate-mobile-profile</id>
            <phase>validate</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>cmake</executable>
              <arguments>
                <argument>-DVARIANT=${kompile.mobile}</argument>
                <argument>-DANDROID_SDK=${mobile.android.sdk}</argument>
                <argument>-DANDROID_NDK=${mobile.android.ndk}</argument>
                <argument>-DJAVA_HOME_DIR=${mobile.java.home}</argument>
                <argument>-DMAVEN_OFFLINE=${settings.offline}</argument>
                <argument>-DDL4J_ROOT=${mobile.dl4j.root}</argument>
                <argument>-P</argument>
                <argument>${project.basedir}/cmake/ValidateMobileProfile.cmake</argument>
              </arguments>
            </configuration>
          </execution>

          <execution>
            <id>assemble-mobile-apk</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>${project.basedir}/android/tools/build-offline-accelerators.sh</argument>
                <argument>--variant</argument>
                <argument>${kompile.mobile}</argument>
                <argument>--vulkan-aar</argument>
                <argument>${mobile.aar.vulkan}</argument>
                <argument>--hexagon-aar</argument>
                <argument>${mobile.aar.hexagon}</argument>
                <argument>--tensor-g3-aar</argument>
                <argument>${mobile.aar.tensor.g3}</argument>
                <argument>--tensor-g5-aar</argument>
                <argument>${mobile.aar.tensor.g5}</argument>
                <argument>--graph-library</argument>
                <argument>${mobile.graph.android.library}</argument>
                <argument>--graph-header</argument>
                <argument>${mobile.graph.header}</argument>
                <argument>--graph-verifier</argument>
                <argument>${mobile.graph.verifier}</argument>
                <argument>--javacpp-jar</argument>
                <argument>${mobile.javacpp.jar}</argument>
                <argument>--jni-output</argument>
                <argument>${mobile.android.jni}</argument>
                <argument>--android-sdk</argument>
                <argument>${mobile.android.sdk}</argument>
                <argument>--android-ndk</argument>
                <argument>${mobile.android.ndk}</argument>
                <argument>--java-home</argument>
                <argument>${mobile.java.home}</argument>
                <argument>--maven-artifacts</argument>
                <argument>--output</argument>
                <argument>${mobile.output.dir}</argument>
              </arguments>
              <environmentVariables>
                <DL4J_ROOT>${mobile.dl4j.root}</DL4J_ROOT>
                <SOURCE_DATE_EPOCH>0</SOURCE_DATE_EPOCH>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>mobile-vulkan-artifact</id>
      <activation>
        <property>
          <name>kompile.mobile</name>
          <value>vulkan</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-sdx</artifactId>
          <version>${mobile.sdx.version}</version>
          <classifier>android-arm64-vulkan</classifier>
          <type>aar</type>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>mobile-hexagon-artifact</id>
      <activation>
        <property>
          <name>kompile.mobile</name>
          <value>hexagon</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-sdx</artifactId>
          <version>${mobile.sdx.version}</version>
          <classifier>android-arm64-hexagon</classifier>
          <type>aar</type>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>mobile-tensor-g3-artifact</id>
      <activation>
        <property>
          <name>kompile.mobile</name>
          <value>tensor-g3</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-sdx</artifactId>
          <version>${mobile.sdx.version}</version>
          <classifier>android-arm64-tensor-g3</classifier>
          <type>aar</type>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>mobile-tensor-g5-artifact</id>
      <activation>
        <property>
          <name>kompile.mobile</name>
          <value>tensor-g5</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-sdx-litertlm</artifactId>
          <version>${mobile.sdx.version}</version>
          <classifier>android-arm64-google-tensor-g5</classifier>
          <type>aar</type>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>mobile-all-bundle</id>
      <activation>
        <property>
          <name>kompile.mobile</name>
          <value>all</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-sdx</artifactId>
          <version>${mobile.sdx.version}</version>
          <classifier>android-arm64-vulkan</classifier>
          <type>aar</type>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-sdx</artifactId>
          <version>${mobile.sdx.version}</version>
          <classifier>android-arm64-hexagon</classifier>
          <type>aar</type>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-sdx</artifactId>
          <version>${mobile.sdx.version}</version>
          <classifier>android-arm64-tensor-g3</classifier>
          <type>aar</type>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>org.eclipse.deeplearning4j</groupId>
          <artifactId>nd4j-sdx-litertlm</artifactId>
          <version>${mobile.sdx.version}</version>
          <classifier>android-arm64-google-tensor-g5</classifier>
          <type>aar</type>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>package-mobile-bundle</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>${project.basedir}/package-offline-graph-chat.sh</argument>
                    <argument>--output</argument>
                    <argument>${mobile.bundle}</argument>
                    <argument>--dl4j-root</argument>
                    <argument>${mobile.dl4j.root}</argument>
                    <argument>--examples-root</argument>
                    <argument>${mobile.examples.root}</argument>
                    <argument>--vulkan-apk</argument>
                    <argument>${mobile.apk.vulkan}</argument>
                    <argument>--hexagon-apk</argument>
                    <argument>${mobile.apk.hexagon}</argument>
                    <argument>--tensor-g3-apk</argument>
                    <argument>${mobile.apk.tensor.g3}</argument>
                    <argument>--tensor-g5-apk</argument>
                    <argument>${mobile.apk.tensor.g5}</argument>
                    <argument>--vulkan-aar</argument>
                    <argument>${mobile.aar.vulkan}</argument>
                    <argument>--hexagon-aar</argument>
                    <argument>${mobile.aar.hexagon}</argument>
                    <argument>--tensor-g3-aar</argument>
                    <argument>${mobile.aar.tensor.g3}</argument>
                    <argument>--tensor-g5-aar</argument>
                    <argument>${mobile.aar.tensor.g5}</argument>
                    <argument>--graph-sdk</argument>
                    <argument>${mobile.graph.sdk}</argument>
                    <argument>--android-graph-library</argument>
                    <argument>${mobile.graph.android.library}</argument>
                    <argument>--android-graph-javacpp-library</argument>
                    <argument>${mobile.graph.javacpp.library}</argument>
                    <argument>--graph-header</argument>
                    <argument>${mobile.graph.header}</argument>
                    <argument>--canonical-sdz</argument>
                    <argument>${mobile.canonical.sdz}</argument>
                    <argument>--canonical-sdz-readme</argument>
                    <argument>${mobile.canonical.sdz.readme}</argument>
                  </arguments>
                  <environmentVariables>
                    <SOURCE_DATE_EPOCH>0</SOURCE_DATE_EPOCH>
                  </environmentVariables>
                </configuration>
              </execution>

              <execution>
                <id>verify-mobile-bundle</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>${project.basedir}/verify-offline-graph-chat-bundle.sh</argument>
                    <argument>--bundle</argument>
                    <argument>${mobile.bundle}</argument>
                    <argument>--android-sdk</argument>
                    <argument>${mobile.android.sdk}</argument>
                    <argument>--android-ndk</argument>
                    <argument>${mobile.android.ndk}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
