<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.kompile</groupId>
        <artifactId>kompile-chat-local</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../</relativePath>
    </parent>

    <artifactId>kompile-chat-local-core</artifactId>
    <packaging>jar</packaging>

    <name>Kompile Chat Local Core</name>
    <description>
        Infra-free local chat engine that routes generation through a local SDX model
        (via JNA) or a remote OpenAI-compatible endpoint, with tool-call bridging to
        the local graph reasoning session. No Spring, no Jackson.
    </description>

    <dependencies>
        <!-- Shared dependency-free project/knowledge archive rules used by Android and server. -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-project-contract</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Graph reasoning: provides LocalReasoningSession, LocalToolDispatcher, MiniJson, etc. -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-graph-reasoning-local</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JNA for SDX native library binding -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-project-store</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.junit.jupiter</groupId>
                        <artifactId>junit-jupiter-engine</artifactId>
                        <version>5.10.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
