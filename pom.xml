    <graalvm.sdk.version>24.0.1</graalvm.sdk.version>
    <native-maven-plugin.version>0.10.1</native-maven-plugin.version>
    <!-- Development native images use GraalVM quick build (-Ob). Release builds
         override with -Dnative.quickBuild=false. -->
    <native.quickBuild>true</native.quickBuild>
    <graalvm-buildtools.version>${native-maven-plugin.version}</graalvm-buildtools.version>
    <maven-shade-plugin.version>3.5.1</maven-shade-plugin.version>

    <javacpp.version>1.5.13</javacpp.version>
    <!-- Custom local DL4J builds are consumed by overriding -Dnd4j.version=<custom>
         (see build-scripts/build-dl4j-backend.sh for the full custom-build script). -->
    <nd4j.version>1.0.0-SNAPSHOT</nd4j.version>
    <nd4j.backend>nd4j-native</nd4j.backend>
    <!-- The Java backend POM and the classified native binary share an artifactId.
         Version-qualified ZLUDA releases use nd4j-zluda-12.9 for both, with the
         ROCm runtime version carried by the JavaCPP classifier extension. -->
    <nd4j.native.backend>${nd4j.backend}</nd4j.native.backend>
    <!-- Activated repository credentials belong in settings.xml under this id. -->
    <dl4j.repository.id>dl4j-release</dl4j.repository.id>

    <ztexec.version>1.12</ztexec.version>
    <ztprocesskiller.version>1.10</ztprocesskiller.version>
    <progressbar.version>0.10.0</progressbar.version>
    <netty.version>4.1.100.Final</netty.version>
    <kotlin.version>1.9.22</kotlin.version>
    <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>
    <flatbuffers.version>23.5.26</flatbuffers.version>
    <conscrypt.version>2.5.2</conscrypt.version>
    <jgit.version>6.8.0.202311291450-r</jgit.version>
    <classgraph.version>4.8.165</classgraph.version>
    <commons-io.version>2.18.0</commons-io.version>
    <commons-compress.version>1.27.1</commons-compress.version>
    <commons-lang3.version>3.14.0</commons-lang3.version>
    <!-- Keep the jdk18on provider, PKIX, utility, and mail artifacts binary-compatible.
         Several document loaders contribute different transitive versions; a mixed
         set fails GraalVM class initialization before the application image is built. -->
    <bouncycastle.version>1.80</bouncycastle.version>
    <guava.version>32.1.3-jre</guava.version>
    <vertx.version>4.5.7</vertx.version>

    <spring-boot.version>3.2.5</spring-boot.version>
    <spring-ai.version>1.0.0</spring-ai.version>
    <anserini.version>0.1.0-SNAPSHOT</anserini.version>
    <log4j2.version>2.21.1</log4j2.version>
    <jsoup.version>1.17.2</jsoup.version>
    <frontend-maven-plugin.version>1.15.0</frontend-maven-plugin.version>
    <node.version>v20.11.1</node.version>
    <npm.version>10.2.4</npm.version>

    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <maven-clean-plugin.version>3.3.2</maven-clean-plugin.version>
    <maven-install-plugin.version>3.1.2</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <hibernate.version>6.4.4.Final</hibernate.version>
    <jline.version>3.26.1</jline.version>
    <!-- Native distributions flatten one JNA dispatcher into lib/. Keep every
         executable's Java closure on the same native ABI. -->
    <jna.version>5.16.0</jna.version>
    <!-- Spring Boot 3.2.3 manages 3.43.2.0 for app-side workers. Native
         distributions flatten one SQLite JNI library, so CLI and workers must agree. -->
    <sqlite.jdbc.version>3.43.2.0</sqlite.jdbc.version>

    <!-- Platform-specific native resource configurations -->
    <javacpp.platform.extension></javacpp.platform.extension>
    <!-- SDK/native artifacts use their release classifier; distributions retain the full release lane. -->
    <kompile.distribution.platform.classifier>${javacpp.platform}</kompile.distribution.platform.classifier>
    <!-- tokenizers-native is published on CPU lanes, independently of an accelerator backend. -->
    <tokenizers.platform.classifier>${javacpp.platform}</tokenizers.platform.classifier>

    <!-- Default exclusions (will be overridden by profiles) -->
    <!-- Native executables side-load every JNI/backend library from the distribution.
         Native-image resources contain metadata/configuration only; platform payloads must
         never enter the image builder's resource closure. -->
    <native.bytedeco.metadata.pattern>org/bytedeco/.*/properties/.*</native.bytedeco.metadata.pattern>
    <!-- SharedCompilerRuntime reads this classifier-local manifest dynamically at
         runtime; keep it in native images while side-loading only the binary payload. -->
    <native.nd4j.config.pattern>org/nd4j/((linalg/factory|config)/.*|.*/shared-runtime-manifest\.txt)</native.nd4j.config.pattern>
    <native.include.pattern>(${native.bytedeco.metadata.pattern}|${native.nd4j.config.pattern})</native.include.pattern>
    <native.exclude.platform.payload>(.*/)?(linux|windows|macosx|android|ios)[^/]*/.*\.(so(\..*)?|dylib|dll|a|lib|o|obj|vsa|vso)$</native.exclude.platform.payload>
    <native.exclude.library.payload>.*\.(so(\..*)?|dylib|dll|a|lib|o|obj|vsa|vso)$</native.exclude.library.payload>
    <native.exclude.windows>org/bytedeco/.*/windows-.*</native.exclude.windows>
    <native.exclude.macosx>org/bytedeco/.*/macosx-.*</native.exclude.macosx>
    <native.exclude.linux.arm>org/bytedeco/.*/linux-arm.*</native.exclude.linux.arm>
    <native.exclude.linux.ppc>org/bytedeco/.*/linux-ppc.*</native.exclude.linux.ppc>
    <native.exclude.linux.x86>org/bytedeco/.*/linux-x86_64/.*</native.exclude.linux.x86>
    <native.exclude.android>org/bytedeco/.*/android-.*</native.exclude.android>
    <native.exclude.ios>org/bytedeco/.*/ios-.*</native.exclude.ios>
    <javacpp.platform></javacpp.platform>
  </properties>
