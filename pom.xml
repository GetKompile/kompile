    <!--
      Curated end-to-end distribution profile.
      Activated by -Dkompile.dist=true (NOT -Pdist, because child module
      profile activation only sees user/system properties, not parent
      profile properties). The same flag propagates to every child native
      profile (native, native-ingest, native-vector, native-embedding,
      native-model-init, native-library, plus CLI natives and app-lite),
      and adds the kompile-dist assembly module to the reactor.

      Example: mvn clean package -Dkompile.dist=true
    -->
    <profile>
      <id>dist</id>
      <activation>
        <property>
          <name>kompile.dist</name>
        </property>
      </activation>
      <modules>
        <module>kompile-dist</module>
      </modules>
    </profile>

    <!--
      Lean native distribution for standard CLI chat and folder-local MCP/model
      orchestration. Native workers are built explicitly by
      build-scripts/build-kompile-local.sh; this module owns canonical packaging
      and Maven attachment without pulling the web/batch distribution into scope.
    -->
    <profile>
      <id>local-dist</id>
      <activation>
        <property>
          <name>kompile.local.dist</name>
        </property>
      </activation>
      <modules>
        <module>kompile-local-dist</module>
      </modules>
    </profile>
  </profiles>
</project>
