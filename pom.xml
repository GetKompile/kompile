                      <not><equals arg1="${javacpp.platform}" arg2="linux-x86_64"/></not>
                    </condition>
                    <fail if="kompile.rocm10.unsupported.platform"
                          message="ROCm 10 ZLUDA builds require javacpp.platform=linux-x86_64 (got ${javacpp.platform})"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
