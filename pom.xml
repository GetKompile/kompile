  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <compilerArgs>
              <arg>-parameters</arg>
            </compilerArgs>
            <source>${maven.compiler.source}</source>
            <target>${maven.compiler.target}</target>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <path>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-codegen</artifactId>
                <version>${pico.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.jetbrains.kotlin</groupId>
          <artifactId>kotlin-maven-plugin</artifactId>
          <version>${kotlin.version}</version>
          <configuration>
            <jvmTarget>${kotlin.compiler.jvmTarget}</jvmTarget>
            <args>
              <arg>-Xjsr305=strict</arg>
            </args>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>org.jetbrains.kotlin</groupId>
              <artifactId>kotlin-maven-allopen</artifactId>
              <version>${kotlin.version}</version>
            </dependency>
            <dependency>
              <groupId>org.jetbrains.kotlin</groupId>
              <artifactId>kotlin-maven-noarg</artifactId>
              <version>${kotlin.version}</version>
            </dependency>
          </dependencies>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
          <configuration>
            <filters>
              <filter>
                <artifact>*:*</artifact>
                <excludes>
                  <exclude>org/datanucleus/**</exclude>
                  <exclude>META-INF/*.SF</exclude>
                  <exclude>META-INF/*.DSA</exclude>
                  <exclude>META-INF/*.RSA</exclude>
                  <exclude>${native.exclude.windows}</exclude>
                  <exclude>${native.exclude.macosx}</exclude>
                  <exclude>${native.exclude.linux.arm}</exclude>
                  <exclude>${native.exclude.linux.ppc}</exclude>
                  <exclude>${native.exclude.linux.x86}</exclude>
                  <exclude>${native.exclude.android}</exclude>
                  <exclude>${native.exclude.ios}</exclude>
                  <exclude>**/javacpp.jar</exclude>
                  <exclude>**/lib/jna.jar</exclude>
                  <exclude>**/lib/test-classes</exclude>
                  <exclude>**/test-classes/**</exclude>
                </excludes>
              </filter>
            </filters>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.graalvm.buildtools</groupId>
          <artifactId>native-maven-plugin</artifactId>
          <version>${native-maven-plugin.version}</version>
          <configuration>
            <quickBuild>${native.quickBuild}</quickBuild>
            <buildArgs>
              <buildArg>-J-Xmx32g</buildArg>
              <buildArg>--verbose</buildArg>
              <buildArg>--no-fallback</buildArg>
              <buildArg>--allow-incomplete-classpath</buildArg>
              <buildArg>-H:+ReportExceptionStackTraces</buildArg>
              <buildArg>--initialize-at-run-time=org.eclipse.deeplearning4j.linalg.factory.Nd4j</buildArg>
              <buildArg>--initialize-at-run-time=org.eclipse.deeplearning4j.nativeblas.NativeOpsHolder</buildArg>
              <buildArg>--initialize-at-run-time=org.bytedeco.javacpp.Loader</buildArg>
              <buildArg>-H:Log=registerResource:3</buildArg>
              <buildArg>-H:IncludeResources=META-INF/services/.*</buildArg>
              <buildArg>-H:IncludeResources=org/nd4j/linalg/factory/.*</buildArg>
              <buildArg>-H:IncludeResources=org/nd4j/config/.*</buildArg>
              <buildArg>-H:IncludeResources=${native.include.pattern}</buildArg>
              <arg>--enable-preview</arg>

              <buildArg>-H:ExcludeResources=${native.exclude.windows}</buildArg>
              <buildArg>-H:ExcludeResources=${native.exclude.macosx}</buildArg>
              <buildArg>-H:ExcludeResources=${native.exclude.linux.arm}</buildArg>
              <buildArg>-H:ExcludeResources=${native.exclude.linux.ppc}</buildArg>
              <buildArg>-H:ExcludeResources=${native.exclude.linux.x86}</buildArg>
              <buildArg>-H:ExcludeResources=${native.exclude.android}</buildArg>
              <buildArg>-H:ExcludeResources=${native.exclude.ios}</buildArg>

              <buildArg>-H:ExcludeResources=.*/javacpp\.jar</buildArg>
              <buildArg>-H:ExcludeResources=.*/lib/jna\.jar</buildArg>
              <buildArg>-H:ExcludeResources=.*/lib/test-classes</buildArg>
              <buildArg>-H:ExcludeResources=.*/\.jar$</buildArg>
              <buildArg>-H:ExcludeResources=.*/\.zip$</buildArg>
              <!-- Platform/JNI payloads are always side-loaded from dist/lib. These
                   exclusions also override stale tracing-agent resource configurations. -->
              <buildArg>-H:ExcludeResources=${native.exclude.platform.payload}</buildArg>
              <buildArg>-H:ExcludeResources=${native.exclude.library.payload}</buildArg>
            </buildArgs>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>

    <profile>
      <id>linux</id>
      <activation>
        <os>
          <name>linux</name>
        </os>
      </activation>
      <properties>
        <os.kernel>linux</os.kernel>
        <os.name>linux</os.name>
      </properties>
    </profile>
    <profile>
      <id>macosx</id>
      <activation>
        <os>
          <name>mac os x</name>
        </os>
      </activation>
      <properties>
        <os.kernel>darwin</os.kernel>
        <os.name>macosx</os.name>
      </properties>
    </profile>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <os.kernel>windows</os.kernel>
        <os.name>windows</os.name>
      </properties>
    </profile>
    <profile>
      <id>arm</id>
      <activation>
        <os>
          <arch>arm</arch>
        </os>
      </activation>
      <properties>
        <os.arch>armhf</os.arch>
      </properties>
    </profile>
    <profile>
      <id>android</id>
      <activation>
        <os><name>android</name></os>
      </activation>
      <properties>
        <os.kernel>linux</os.kernel>
        <os.name>android</os.name>
        <os.arch>arm</os.arch>
      </properties>
    </profile>
    <profile>
      <id>aarch64</id>
      <activation>
        <os>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <os.arch>arm64</os.arch>
      </properties>
    </profile>
    <profile>
      <id>armv8</id>
