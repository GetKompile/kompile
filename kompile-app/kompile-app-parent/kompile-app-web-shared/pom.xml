        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-ingest-svc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-subprocess-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The graph-matrix subprocess. Needed at compile time even though the process itself is a
             separate JVM: SubprocessMatrixGraphStore and GraphServiceSubprocessClients call the
             INDArray codec statics on GraphMatrixSubprocessMain, and GraphMatrixSubprocessLauncher
             names the class. Declared here rather than in kompile-app-web-graph because every
             persona process needs the @Primary subprocess store — including the admin console after
             it drops web-graph. Without it Spring silently falls back to VectorStoreMatrixGraphStore
             and runs matrix graph compute inside the web process. -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-subprocess-graph</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Bayesian / PSL / event-attribution services that GraphServiceSubprocessClients proxies
             into the graph-matrix subprocess. Arrived transitively before; now imported directly. -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-event-attribution</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-cli-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-knowledge-graph</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-graph-reasoning</artifactId>
        </dependency>
        <dependency>
