<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.kompile</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-agent</artifactId>
    <name>Kompile App - Agent / Chat</name>
    <description>
        The agent / CLI-chat domain extracted from kompile-app-main's services package
        (ai.kompile.app.services.agent): AgentChatService, the CLI-agent LLM chat + model services,
        passthrough session management (PTY-backed), reasoning-trace storage and the
        ReasoningTrailMapper. Its former single edge up into app-main (AgentChatService →
        tools.KbVerifyExplainTool for the reasoning-trail→DTO mapping) was inverted by extracting that
        pure mapper here; KbVerifyExplainTool now delegates to it. Depends on the already-extracted
        platform (ServerPortService) + mcp (ToolCallWriterService) + dto + rag modules and the
        orchestrator / chat-history / knowledge-graph / graph-reasoning leaf modules. Package preserved.
        See docs/architecture/services-decomposition-spec.md.
    </description>

    <dependencies>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-dto</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-rag</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-graph-reasoning</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-knowledge-graph</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-orchestrator</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-chat-history</artifactId>
        </dependency>

        <!-- CLI-agent chat REST/streaming + Spring-AI chat client (spring-ai transitively via app-core) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- PTY-backed passthrough sessions for interactive CLI agents -->
        <dependency>
            <groupId>org.jetbrains.pty4j</groupId>
            <artifactId>pty4j</artifactId>
            <version>0.12.13</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <repositories>
        <!-- pty4j's purejavacomm transitive is published to JetBrains' repo, not Maven Central. -->
        <repository>
            <id>intellij-dependencies</id>
            <name>JetBrains IntelliJ Dependencies</name>
            <url>https://cache-redirector.jetbrains.com/intellij-dependencies</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
</project>
