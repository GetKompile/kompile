<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.kompile</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-ingest</artifactId>
    <name>Kompile App - Ingest (in-process orchestration + domain)</name>
    <description>
        The in-process document-ingest layer extracted from kompile-app-main (ai.kompile.app.ingest):
        indexed-document / crawl-job JPA domain + repositories, the ingest event/history/job-log
        services, and progress reporting. Distinct from kompile-app-subprocess-ingest (the off-heap
        subprocess Mains). Its two former edges up into app-main are inverted: ingest→services
        (Nd4jEnvironmentConfigService) via the Nd4jEnvironmentConfigProvider SPI declared here, and
        ingest→config (the ingest-event transaction-manager name) via the module-owned
        IngestTransactionManagers constant (referenced back by app-main's PrimaryDataSourceConfig).
        Progress DTOs come from the shared kompile-app-dto module. No compile-time coupling into app-main.
    </description>

    <dependencies>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-dto</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-embedding-anserini</artifactId>
        </dependency>

        <!-- JPA domain (IndexedDocument, CrawlJobRecord, …) + Spring Data repositories -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- SimpMessagingTemplate progress broadcast (STOMP) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
