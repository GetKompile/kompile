<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-config</artifactId>
    <name>Kompile App - Low-level Config (properties + holders)</name>
    <description>
        The low-level, app-main-decoupled configuration classes extracted from kompile-app-main
        (ai.kompile.app.config): @ConfigurationProperties and config holders for models, memory,
        schedulers, chunking, subprocess, websocket, etc. — everything in the config package that
        references NOTHING in app-main's higher layers. The application's composition/wiring config
        (the @Configuration classes that wire services — A2A, device-routing, VLM, GPU, MCP-SSE, the
        multi-datasource PrimaryDataSourceConfig, …) intentionally stays in kompile-app-main. Package
        name is preserved (shared with app-core's config subset), so native-image reflect-config and
        the ~56 in-app importers are unaffected.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-embedding-anserini</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-model-manager</artifactId>
        </dependency>
        <!-- WebSocketConfig + a few web-facing config holders -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- McpClientConfiguration: the io.modelcontextprotocol client/spec SDK -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
