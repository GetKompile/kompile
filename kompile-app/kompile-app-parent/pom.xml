<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>kompile-app</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-parent</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>kompile-app-core</module>
        <module>kompile-app-config</module>
        <module>kompile-app-dto</module>
        <module>kompile-app-lite</module>
        <module>kompile-app-subprocess</module>
        <module>kompile-app-rag</module>
        <module>kompile-app-source</module>
        <module>kompile-app-facts</module>
        <module>kompile-app-ingest</module>
        <module>kompile-app-platform</module>
        <module>kompile-app-mcp</module>
        <module>kompile-app-agent</module>
        <module>kompile-app-crawl</module>
        <module>kompile-app-ingest-svc</module>
        <module>kompile-app-ontology</module>
        <module>kompile-app-crawl-svc</module>
        <module>kompile-app-enforcer</module>
        <module>kompile-app-diff</module>
        <!-- Web-layer modules. Each app mounts a subset; an endpoint a persona does not
             own is not on its classpath. See docs/architecture/app-persona-boundary.md. -->
        <module>kompile-app-web-shared</module>
        <module>kompile-app-web-graph</module>
        <module>kompile-app-web-chat</module>
        <module>kompile-app-web-crawl</module>
        <module>kompile-app-web-admin</module>
        <!-- Angular workspace: one shared library plus one SPA per persona, attached as the
             classified jars -chat / -crawl / -admin. See docs/architecture/ui-persona-boundary.md. -->
        <module>kompile-app-ui</module>
        <!-- The three runnable processes. kompile-app-main is the admin console (:8080) and stays
             a LIBRARY — its exec jar is opt-in behind -Dkompile.uber. The two end-user apps follow
             kompile-model-staging and build their -exec.jar on every build. -->
        <module>kompile-app-chat</module>
        <module>kompile-app-crawl-manager</module>
        <module>kompile-app-main</module>
    </modules>
</project>
