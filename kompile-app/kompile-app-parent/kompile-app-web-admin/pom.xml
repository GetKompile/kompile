        <!-- ComprehensiveDiagnosticsController and LifecycleTrackingController read allocation,
             TAD/shape-cache and lifecycle-tracking counters off Environment and NativeOps. Those
             methods are declared by the backend, not by nd4j-api, so this module needs a backend to
             compile against. It is `provided`: this is a web-layer library and must not put a
             compute backend (or the platform-classified libnd4j twin) into anyone's dependency
             graph — the app that mounts it, kompile-app-main, selects and ships the real backend
             via -Dnd4j.backend. -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>${nd4j.backend}</artifactId>
            <version>${nd4j.version}</version>
            <scope>provided</scope>
        </dependency>
