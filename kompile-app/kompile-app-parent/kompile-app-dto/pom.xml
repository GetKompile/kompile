<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-dto</artifactId>
    <name>Kompile App - Shared DTO Kernel</name>
    <description>
        The shared request/response/progress DTO kernel (ai.kompile.app.web.dto) extracted from
        kompile-app-main. These are plain data classes (Jackson-serializable) consumed by BOTH the
        web controller layer and the service layer — most notably IngestProgressUpdate. Pulling them
        into a module below both breaks the former services ⇄ web circular dependency (services only
        ever imported web.dto.*, never controllers), which is the keystone for any future
        web/services separation. The one subpackage that reaches into app-main domain
        (web.dto.crossindex → ingest.domain.IndexedDocument.OverallIndexStatus) intentionally stays
        in kompile-app-main.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Two ontology DTOs reference process.ontology.OntologySchema -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-process-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
