<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-crawl-svc</artifactId>
    <name>Kompile App - Crawl Orchestration (upper layer)</name>
    <description>
        The crawl-orchestration services that sit ABOVE the ingest service layer: single-source crawl
        start + preview, crawl-job persistence, graph schema presets, processing route config and
        capacity tracking, and the Quartz scheduling layer (ScheduledPipelineService plus the
        re-ingestion, staleness-check and eval-suite jobs).

        These could not join the existing kompile-app-crawl module: they reach into
        kompile-app-ingest-svc (YouTubeTranscriptService, IndexSyncService, DocumentFreshnessService)
        and kompile-app-crawl is a *dependency* of ingest-svc, so folding them in would close a cycle.
        They therefore form their own module one layer up. Sibling of kompile-app-ontology; neither
        references the other.

        Extracted so the crawl web controllers can move into a persona app without dragging the admin
        console along. Package preserved (ai.kompile.app.services, .services.scheduling). See
        docs/architecture/services-decomposition-spec.md and
        docs/architecture/app-persona-boundary.md.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-facts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-ingest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-ingest-svc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-cli-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-crawl-graph</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
