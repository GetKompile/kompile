<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-core</artifactId> <name>Kompile App - Core Abstractions</name>
    <description>Core interfaces and DTOs for the RAG MCP Assistant</description>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-cli-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-utils</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId> </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId></dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>
        <!-- https://mvnrepository.com/artifact/jakarta.annotation/jakarta.annotation-api -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>

        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-api</artifactId>
            <version>${nd4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-ocr-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Export test classes as test-jar for reuse in other modules -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Roster gate: cli-agents.json is the single source of truth for every CLI
                 agent lane (passthrough, delegation, managed TUI). A partial roster baked
                 into ~/.m2 silently ships agent-lockout in every downstream binary, and
                 tests don't run in dist/native lanes — so this check is bound to validate
                 and fires on EVERY build, including -DskipTests. Removing an agent must be
                 deliberate: update this gate, CliAgentRegistryTest, and the matching gate
                 in kompile-cli-main/pom.xml in the same commit. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>verify-cli-agent-roster</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <condition property="cliAgentsRosterComplete">
                                    <and>
                                        <resourcecontains resource="${project.basedir}/src/main/resources/cli-agents.json" substring="&quot;claude-cli&quot;"/>
                                        <resourcecontains resource="${project.basedir}/src/main/resources/cli-agents.json" substring="&quot;codex-cli&quot;"/>
                                        <resourcecontains resource="${project.basedir}/src/main/resources/cli-agents.json" substring="&quot;gemini-cli&quot;"/>
                                        <resourcecontains resource="${project.basedir}/src/main/resources/cli-agents.json" substring="&quot;opencode-cli&quot;"/>
                                        <resourcecontains resource="${project.basedir}/src/main/resources/cli-agents.json" substring="&quot;qwen-cli&quot;"/>
                                        <resourcecontains resource="${project.basedir}/src/main/resources/cli-agents.json" substring="&quot;pi-cli&quot;"/>
                                    </and>
                                </condition>
                                <fail unless="cliAgentsRosterComplete">cli-agents.json is missing part of the required agent roster (claude-cli, codex-cli, gemini-cli, opencode-cli, qwen-cli, pi-cli). This registry feeds ALL agent lanes; a partial roster ships agent-lockout in every downstream binary. If the roster is genuinely changing, update this gate, CliAgentRegistryTest, and the registry gate in kompile-cli-main/pom.xml in the same commit.</fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>