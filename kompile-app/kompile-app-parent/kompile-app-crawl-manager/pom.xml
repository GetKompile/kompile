<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.kompile</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-crawl-manager</artifactId>
    <name>Kompile App - Crawl Manager (end-user process)</name>
    <description>
        The crawl-manager persona process (:8082): the unified crawl surface, ingestion and
        indexing, fact sheets, the documents and index browser, note sync / connections, and
        read-only graph viewing. Admin APIs are absent because kompile-app-web-admin is not a
        dependency — the classpath IS the boundary, since every web module shares the package
        ai.kompile.app.web.controllers and scanBasePackages therefore cannot separate them.

        Unlike kompile-app-main (a LIBRARY whose exec jar is opt-in behind -Dkompile.uber) this is a
        plain runnable service and follows kompile-model-staging: thin main artifact plus an
        -exec.jar classifier produced on every build.

        See docs/architecture/app-persona-boundary.md.
    </description>

    <properties>
        <start-class>ai.kompile.app.crawlmanager.CrawlManagerApplication</start-class>
    </properties>

    <dependencies>
        <!-- Persona surface. web-shared also carries the pre-Spring server bootstrap
             (ai.kompile.app.runtime.KompileServerRuntime), the shutdown handlers, and the
             EnvironmentPostProcessor that seeds the framework defaults. -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-web-shared</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-web-crawl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-web-graph</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            The crawl SPA. Boot serves classpath:/static/ out of any jar, so declaring this jar is
            the whole wiring: no unpack, no copy into src/main/resources. Declare exactly ONE spa
            classifier here — a second one would put two index.html files on the classpath and
            which SPA loads would come down to jar order.
        -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-ui</artifactId>
            <version>${project.version}</version>
            <classifier>crawl</classifier>
        </dependency>

        <!-- Document loaders. The crawl manager is the process that actually parses source
             documents, so the loader implementations the orchestrator discovers must be here;
             without them ingestion silently supports nothing. -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-pdf-extended</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-pdf-tables</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-microsoft</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-web</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-tika</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-gdrive</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-onedrive</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-slack</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-discord</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-email-imap</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-email-inbox</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-gdocs</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-gmail</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-loader-google-workspace</artifactId>
        </dependency>
        <!-- Table-aware chunker for structured data -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-chunker-table-aware</artifactId>
        </dependency>
        <!-- Crawl-time language enrichment. kompile-crawler-core marks kompile-langdetect <optional>,
             so it never arrives transitively and CrawlLanguageDetector's @ConditionalOnClass silently
             switches the whole feature off. The crawl manager is the process that runs crawls, so it
             is the process that declares it. -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-langdetect</artifactId>
        </dependency>
        <!-- OCR for scanned sources -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-ocr-integration</artifactId>
        </dependency>
        <!-- kompile-ocr-integration does NOT declare this itself: VlmDocumentPipeline names
             VlmKvCacheIntegrationService in a constructor, so Spring has to resolve the class even when
             the bean is absent. app-main happens to declare kompile-kvcache for its own reasons, which
             is why the gap only showed up here — the crawl manager died on
             NoClassDefFoundError: ai/kompile/kvcache/bridge/VlmKvCacheIntegrationService. -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-kvcache</artifactId>
        </dependency>
        <!-- Note sync / Connections is a crawl-manager surface: the OAuth-backed source providers
             registered through /api/source-providers have to be on THIS classpath, otherwise the
             provider list comes back empty. -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-gdrive</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-onedrive</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-confluence</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-jira</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-reddit</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-notion</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-slack</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-discord</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-email</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-gdocs</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-gmail</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-source-google-workspace</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-oauth2-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Jakarta Bean Validation provider (Hibernate Validator) — moved controllers use @Valid. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Hibernate 6 loads its ByteBuddy BytecodeProvider via ServiceLoader at
             EntityManagerFactory bootstrap. byte-buddy is excluded from spring-boot-starter-data-jpa
             tree-wide (kompile-app/pom.xml dependencyManagement, native-image hygiene), which breaks
             the JVM exec-jar tier with NoClassDefFoundError. Same reason app-main declares it. -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.14.13</version>
        </dependency>
        <!-- H2 backs the orchestrator JPA datasource that KompileBootstrapEnvironmentPostProcessor
             seeds; without it DataSource auto-configuration fails at startup. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <!-- Spring AOT emits H2ConsoleAutoConfiguration sources that javac must resolve. -->
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <!-- Bridge Log4j2 API calls to SLF4J/Logback (replaces log4j-core) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-to-slf4j</artifactId>
        </dependency>

        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-api</artifactId>
        </dependency>
        <!-- Compute backend. KompileServerRuntime.bootstrap() loads the ND4J backend before Spring
             starts, so without one here startup dies in Nd4jBackend.load(). Select via
             -Dnd4j.backend (or the root backend-* alias profiles); defaults to nd4j-native. -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>${nd4j.backend}</artifactId>
            <version>${nd4j.version}</version>
            <exclusions>
                <!-- The explicit platform dependency below selects the requested CPU/accelerator
                     lane. Do not also inherit nd4j-native's unsuffixed platform twin: it can add a
                     second multi-gigabyte native archive to the Boot exec JAR. -->
                <exclusion>
                    <groupId>org.eclipse.deeplearning4j</groupId>
                    <artifactId>${nd4j.native.backend}</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Platform-classified twin: carries the compute library (libnd4jcpu.so /
             libnd4jcuda.so). Without it the exec jar ships the JavaCPP JNI wrappers but no
             libnd4j. ${javacpp.platform} is set by the root pom's OS profiles. -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>${nd4j.native.backend}</artifactId>
            <version>${nd4j.version}</version>
            <classifier>${javacpp.platform}${javacpp.platform.extension}</classifier>
            <exclusions>
                <!-- A classified ND4J backend POM inherits the unsuffixed platform twin. The
                     selected classifier already carries the platform payload; retaining both can
                     exceed Spring Boot's executable-JAR offset limit. -->
                <exclusion>
                    <groupId>org.eclipse.deeplearning4j</groupId>
                    <artifactId>${nd4j.native.backend}</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacpp.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PersonaApiSurface + PersonaSurfaces, used by CrawlManagerPersonaBoundaryTest to assert
             that this app mounts the crawl surface and nothing else. Shared as a test-jar so all
             three personas scan the classpath the same way and agree on which module owns which
             base path. -->
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-web-shared</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- CUDA dual-backend: when -Dkompile.cuda activates the CUDA-variant dist build the
             primary ${nd4j.backend} dep is already swapped to nd4j-cuda-*, and without this the
             exec jar would ship ONLY the CUDA backend with no CPU fallback for BackendManager.
             Mirrors kompile-app-main and kompile-model-staging. -->
        <profile>
            <id>cuda-dual-backend</id>
            <activation>
                <property>
                    <name>kompile.cuda</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.eclipse.deeplearning4j</groupId>
                    <artifactId>nd4j-native</artifactId>
                    <version>${nd4j.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.deeplearning4j</groupId>
                    <artifactId>nd4j-native</artifactId>
                    <version>${nd4j.version}</version>
                    <classifier>${javacpp.platform}</classifier>
                </dependency>
            </dependencies>
        </profile>

        <!--
            GraalVM native image, same contract as kompile-app-main's `native` profile:
            activated by -Dkompile.dist so a dist build produces BOTH the AOT binary and the
            exec jar, and the launcher can prefer the binary with the jar as fallback.

            imageName MUST be the shipped DIST name, not the artifactId: kompile-dist/dist.xml
            picks the binary up with a fileSet, which cannot rename, so build-dist.sh and the
            assembly only agree if the built name is already the shipped name.

            The class-initialization policy is NOT repeated here — kompile-app-web-shared ships
            META-INF/native-image/ai.kompile/kompile-app-web-shared/native-image.properties and
            GraalVM auto-discovers it off the image classpath. Only build-machine flags, the
            resource policy and the config directories live in this pom.
        -->
        <profile>
            <id>native</id>
            <properties>
                <kompile.windows.aot.skip>false</kompile.windows.aot.skip>
            </properties>
            <activation>
                <property>
                    <name>kompile.dist</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <!-- Side-loaded natives: the image cannot carry the JavaCPP/ND4J .so files,
                         so unpack them from the dependency jars into target/native-libs.
                         NativeLibraryResolver loads them from the dist lib/ dir at runtime. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-native-libs</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>unpack-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/native-libs</outputDirectory>
                                    <includeTypes>jar</includeTypes>
                                    <includes>**/*.so,**/*.so.*,**/*.dylib,**/*.dll</includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>${start-class}</mainClass>
                            <imageName>kompile-crawl-manager</imageName>
                            <buildArgs combine.children="append">
                                <buildArg>-J-Xmx32g</buildArg>
                                <buildArg>--enable-monitoring=jfr</buildArg>
                                <buildArg>--verbose</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>-H:DeadlockWatchdogInterval=30</buildArg>
                                <buildArg>-H:+DeadlockWatchdogExitOnTimeout</buildArg>
                                <!-- Agent-generated reflection/JNI/resource configs. These were
                                     traced against app-main and cover the Spring + ND4J + Lucene
                                     surface the personas share, plus the subprocess types this
                                     binary self-execs (see SubprocessDispatcher). Referenced in
                                     place rather than copied: one traced config, three images. -->
                                <buildArg>-H:ConfigurationFileDirectories=${project.basedir}/../kompile-app-main/src/main/resources/META-INF/native-image/main,${project.basedir}/../kompile-app-main/src/main/resources/META-INF/native-image/ingest,${project.basedir}/../kompile-app-main/src/main/resources/META-INF/native-image/vector,${project.basedir}/../kompile-app-main/src/main/resources/META-INF/native-image/embedding,${project.basedir}/../kompile-app-main/src/main/resources/META-INF/native-image/model-init,${project.basedir}/../kompile-app-main/src/main/resources/META-INF/native-image/graph,${project.basedir}/../kompile-app-main/src/main/resources/META-INF/native-image/subprocess-args-shared</buildArg>
                                <!-- Resource inclusion -->
                                <buildArg>-H:IncludeResources=static/.*</buildArg>
                                <buildArg>-H:IncludeResources=application.*</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/native-image/.*\.json</buildArg>
                                <buildArg>-H:IncludeResources=${native.bytedeco.metadata.pattern}</buildArg>
                                <buildArg>-H:IncludeResources=${native.nd4j.config.pattern}</buildArg>
                                <!-- JNI/backend binaries are loaded from the distribution lib/ tree. -->
                                <buildArg>-H:ExcludeResources=${native.exclude.platform.payload}</buildArg>
                                <buildArg>-H:ExcludeResources=${native.exclude.library.payload}</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/services/.*</buildArg>
                                <buildArg>-H:ExcludeResources=META-INF/services/org.hibernate.bytecode.spi.BytecodeProvider</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/spring/.*</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/spring\.factories</buildArg>
                                <buildArg>-H:IncludeResources=opennlp/.*</buildArg>
                                <buildArg>-H:IncludeResources=log4j2\.component\.properties</buildArg>
                                <!-- Exclude native binaries from image - side-loaded at runtime -->
                                <buildArg>-H:ExcludeResources=org/bytedeco/.*\.so$</buildArg>
                                <buildArg>-H:ExcludeResources=org/bytedeco/.*\.so\..*</buildArg>
                                <buildArg>-H:ExcludeResources=org/bytedeco/.*\.dll$</buildArg>
                                <buildArg>-H:ExcludeResources=org/bytedeco/.*\.dylib$</buildArg>
                                <buildArg>-H:ExcludeResources=org/nd4j/.*\.so$</buildArg>
                                <buildArg>-H:ExcludeResources=org/nd4j/.*\.so\..*</buildArg>
                                <buildArg>-H:ExcludeResources=org/nd4j/.*\.dll$</buildArg>
                                <buildArg>-H:ExcludeResources=org/nd4j/.*\.dylib$</buildArg>
                                <buildArg>-H:ExcludeResources=org/eclipse/deeplearning4j/tokenizers/.*/lib.*\.so.*</buildArg>
                                <buildArg>-H:ExcludeResources=org/eclipse/deeplearning4j/tokenizers/.*/libjni.*\.so</buildArg>
                                <buildArg>-H:ExcludeResources=linux-x86_64/.*\.so$</buildArg>
                                <buildArg>-H:ExcludeResources=linux-x86_64/.*\.so\..*</buildArg>
                                <buildArg>-H:ExcludeResources=linux-aarch64/.*</buildArg>
                                <buildArg>-H:ExcludeResources=windows-x86_64/.*</buildArg>
                                <buildArg>-H:ExcludeResources=macosx-.*/.*</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>${start-class}</mainClass>
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
