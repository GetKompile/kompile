<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.kompile</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-crawl</artifactId>
    <name>Kompile App - Crawl Orchestration</name>
    <description>
        The crawl orchestration domain extracted from kompile-app-main's services package
        (ai.kompile.app.services.crawl): distributed crawl coordination, worker weighting, cluster
        backend health, model-capability resolution and crawl profile auto-start. Its sole stayed-root
        blocker, GraphExtractionConfigService (graph-extraction config, used during crawl/ingest, with a
        nested GraphExtractionConfig type), moves in with it — it depends only on the agent module +
        app-core, and its other users (StagedIngestPipeline, the graph-extraction/unified-crawl web
        controllers) are in app-main, which depends on this module. Sits above platform/ingest/agent in
        the layering. Package preserved. See docs/architecture/services-decomposition-spec.md.
    </description>

    <dependencies>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-ingest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-model-manager</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-crawl-graph</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
