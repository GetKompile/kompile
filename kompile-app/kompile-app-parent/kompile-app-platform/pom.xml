<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-platform</artifactId>
    <name>Kompile App - Platform / Resource Kernel</name>
    <description>
        The platform/resource kernel extracted from kompile-app-main's services package — the low-level
        layer every service domain sits on: model lifecycle/admission/warmup/weight-cache, GPU + device
        routing + GPU→CPU migration, memory pools + watchdog + heavy-memory coordinator, the resource
        governor / telemetry / snapshots, ND4J environment config, Triton cache, op-timing, server-port,
        and the resource-aware scheduler + cluster sub-packages. Verified to import NOTHING else in
        app-main's services (zero back-coupling), so it is the keystone that unblocks decomposing the rest
        of the service layer. Package names preserved (ai.kompile.app.services.*), so native-image config
        and the many in-app importers are unaffected. See docs/architecture/services-decomposition-spec.md.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-dto</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- platform services log resource events via the ingest event/job-log services + implement
             its Nd4jEnvironmentConfigProvider SPI -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-ingest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-embedding-anserini</artifactId>
        </dependency>
        <!-- SimpMessagingTemplate broadcasters (GPU / system-resource) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
