/*
 * Karma config for the shared library's own specs.
 *
 * The library has no build target — apps consume it through the @shared/* path alias — but it
 * does have specs, and they need somewhere to run. `ng test kompile-ui-shared` is that place.
 *
 * `exclude` carries the shared library's share of the monolith's known-broken spec list, split
 * out of the old workspace-root tsconfig.spec.json by where each file now lives.
 *
 * It must stay in step with this project's `test.options.exclude` in angular.json. Excluding here
 * alone does not work: karma discovers specs with its own glob, so the file still gets loaded but
 * is no longer in the TS program, and the run dies with "missing from the TypeScript compilation".
 * That is the loud direction, so drift announces itself on the next `ng test`.
 */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec-shared",
    "types": [
      "jasmine"
    ]
  },
  "files": [
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/lib/components/composite-entity-dialog/**",
    "src/lib/components/graph-hierarchy/graph-hierarchy.component.spec.ts",
    "src/lib/components/graph-overview/**",
    "src/lib/components/graph-visualizer/graph-visualizer.component.spec.ts",
    "src/lib/components/graph-visualizer/source-linking-panel.component.spec.ts",
    "src/lib/services/evaluation.service.spec.ts",
    "src/lib/services/graph.service.spec.ts",
    "src/lib/services/process-engine.service.spec.ts"
  ]
}
