{
  "name": "kompile-app-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",

    "check:boundaries": "node tools/check-project-boundaries.mjs",

    "start:chat": "ng serve chat-app",
    "start:crawl": "ng serve crawl-app",
    "start:admin": "ng serve admin-app",

    "build:chat": "ng build chat-app",
    "build:crawl": "ng build crawl-app",
    "build:admin": "ng build admin-app",
    "build:all": "npm run check:boundaries && npm run build:chat && npm run build:crawl && npm run build:admin",

    "watch:chat": "ng build chat-app --watch --configuration development",
    "watch:crawl": "ng build crawl-app --watch --configuration development",
    "watch:admin": "ng build admin-app --watch --configuration development",

    "test:shared": "ng test kompile-ui-shared --watch=false --browsers=ChromeHeadless",
    "test:chat": "ng test chat-app --watch=false --browsers=ChromeHeadless",
    "test:crawl": "ng test crawl-app --watch=false --browsers=ChromeHeadless",
    "test:admin": "ng test admin-app --watch=false --browsers=ChromeHeadless",
    "test": "npm run test:shared && npm run test:chat && npm run test:crawl && npm run test:admin",

    "e2e": "playwright test",
    "e2e:chat": "playwright test --project=chat",
    "e2e:crawl": "playwright test --project=crawl",
    "e2e:admin": "playwright test --project=admin",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report playwright-report",

    "e2e:cy": "cypress run",
    "e2e:cy:admin": "KOMPILE_PERSONA=admin cypress run",
    "e2e:cy:chat": "KOMPILE_PERSONA=chat cypress run",
    "e2e:cy:crawl": "KOMPILE_PERSONA=crawl cypress run",
    "e2e:cy:all": "npm run e2e:cy:admin && npm run e2e:cy:chat && npm run e2e:cy:crawl",
    "e2e:cy:open": "cypress open",

    "e2e:cli": "playwright test --config=playwright-cli.config.ts",
    "e2e:cli:help": "playwright test --config=playwright-cli.config.ts cli-help",
    "e2e:cli:build": "playwright test --config=playwright-cli.config.ts cli-build",
    "e2e:cli:chat": "playwright test --config=playwright-cli.config.ts cli-chat",
    "e2e:cli:wizard": "playwright test --config=playwright-cli.config.ts cli-wizard",
    "e2e:cli:report": "playwright show-report playwright-report-cli"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.11",
    "@angular/cdk": "19.2.11",
    "@angular/common": "19.2.11",
    "@angular/compiler": "19.2.11",
    "@angular/core": "19.2.11",
    "@angular/forms": "19.2.11",
    "@angular/material": "19.2.11",
    "@angular/platform-browser": "19.2.11",
    "@angular/platform-browser-dynamic": "19.2.11",
    "@angular/router": "19.2.11",
    "@stomp/stompjs": "^7.0.0",
    "bpmn-js": "^18.18.0",
    "d3": "^7.8.5",
    "dompurify": "^3.4.11",
    "graphology": "^0.25.4",
    "highlight.js": "^11.11.0",
    "marked": "^15.0.0",
    "mermaid": "^11.15.0",
    "rxjs": "~7.8.0",
    "sigma": "^3.0.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.11",
    "@angular/cli": "^19.2.11",
    "@angular/compiler-cli": "19.2.11",
    "@playwright/test": "^1.60.0",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^25.9.1",
    "@types/sockjs-client": "^1.5.4",
    "cypress": "^15.17.0",
    "graphology-types": "^0.24.8",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  }
}
