<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-ui</artifactId>
    <name>Kompile App UI</name>
    <description>
        Angular multi-project workspace holding every kompile SPA. One shared library
        (kompile-ui-shared) plus one application project per persona, and this module attaches one
        classified jar per application: -chat, -crawl, -admin, each containing static/**.

        Spring Boot serves classpath:/static/ out of any jar on the classpath, so a Boot app picks
        its SPA by declaring exactly one of these as a runtime dependency — no unpack step, and two
        SPAs cannot collide unless an app wrongly declares two.

        The main artifact is deliberately empty: this module produces no Java. Consumers must ask
        for a classifier.

        Which components belong to which project is not a judgement call — it is the transitive
        closure recorded in docs/architecture/ui-persona-boundary.md, regenerable with
        docs/architecture/ui-persona-closure.py.
    </description>

    <properties>
        <!-- No Java here. Skip the compiler rather than let it warn about an empty source root. -->
        <maven.compiler.skip>true</maven.compiler.skip>
        <maven.install.skip>false</maven.install.skip>
        <frontend.dir>${project.basedir}/src/main/frontend</frontend.dir>
        <spa.stage.dir>${project.build.directory}/spa</spa.stage.dir>
        <!--
            Given a value so ${skipTests} resolves to something in the karma execution's <skip>.
            Left undefined it would interpolate to the literal string, which is never "true", so the
            binding would silently ignore -DskipTests instead of honouring it.
        -->
        <skipTests>false</skipTests>
    </properties>

    <build>
        <plugins>
            <!--
                The main artifact would otherwise be a jar of nothing at all. Produce it anyway so
                the reactor has a primary artifact to attach classifiers to, but keep it empty.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>chat-spa</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>chat</classifier>
                            <classesDirectory>${spa.stage.dir}/chat</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>crawl-spa</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>crawl</classifier>
                            <classesDirectory>${spa.stage.dir}/crawl</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>admin-spa</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>admin</classifier>
                            <classesDirectory>${spa.stage.dir}/admin</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
                Install node and npm. Run with: mvn install -Dui.deps
                Use this the first time you check out the source, and whenever package.json changes.
                Mirrors the kompile-app-main profile this workspace was carved out of.
            -->
            <id>Install node and npm</id>
            <activation>
                <property>
                    <name>ui.deps</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>install node and npm</id>
                                <goals>
                                    <goal>install-node-and-npm</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>src/main/frontend</workingDirectory>
                                    <nodeVersion>${node.version}</nodeVersion>
                                    <npmVersion>${npm.version}</npmVersion>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <!--
                Build the UI by default. To skip: -Dskip.ui

                `npm run build:all` runs the boundary check and then the three application builds.
                kompile-ui-shared has no build step of its own: apps consume it through the
                @shared/* tsconfig path, so its sources are compiled into whichever apps import
                them and nothing needs to be built or published first.
            -->
            <id>Build the UI</id>
            <activation>
                <property>
                    <name>!skip.ui</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>clean-angular-cache</id>
                                <phase>initialize</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete dir="${frontend.dir}/.angular/cache" quiet="true"/>
                                        <delete dir="${frontend.dir}/dist" quiet="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>npm install</id>
                                <goals><goal>npm</goal></goals>
                                <configuration>
                                    <workingDirectory>src/main/frontend</workingDirectory>
                                    <arguments>install</arguments>
                                </configuration>
                            </execution>
                            <!--
                                The id is load-bearing: kompile-app/pom.xml's pluginManagement
                                declares an `angular-build-for-debug` execution running
                                `npm run build`, and pluginManagement executions are inherited by
                                any child that declares the plugin. Matching the id overrides it.
                                A different id would ADD an execution, so the inherited one would
                                still fire — and `build` is not a script in this workspace, which
                                has one per app plus build:all.
                            -->
                            <execution>
                                <id>angular-build-for-debug</id>
                                <goals><goal>npm</goal></goals>
                                <phase>generate-resources</phase>
                                <configuration>
                                    <workingDirectory>src/main/frontend</workingDirectory>
                                    <arguments>run build:all</arguments>
                                </configuration>
                            </execution>
                            <!--
                                The four karma suites, one per workspace project. Without this the
                                specs are dead weight: `mvn test -pl :kompile-app-ui` reported
                                success while running nothing at all, because this module has no
                                Java for surefire to find and nothing else invoked `ng test`.

                                CHROME_BIN is deliberately not set. karma-chrome-launcher falls back
                                to resolving google-chrome / chromium off PATH, which keeps the
                                build portable; pinning an absolute path here would work on one
                                machine and fail on the next.
                            -->
                            <execution>
                                <id>angular-karma</id>
                                <goals><goal>npm</goal></goals>
                                <phase>test</phase>
                                <configuration>
                                    <workingDirectory>src/main/frontend</workingDirectory>
                                    <arguments>run test</arguments>
                                    <skip>${skipTests}</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        Stage each app's browser bundle under its own static/ root. The jar
                        executions above turn each staging directory into a classified jar.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-chat-spa</id>
                                <goals><goal>copy-resources</goal></goals>
                                <phase>prepare-package</phase>
                                <configuration>
                                    <outputDirectory>${spa.stage.dir}/chat/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${frontend.dir}/dist/chat-app/browser</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stage-crawl-spa</id>
                                <goals><goal>copy-resources</goal></goals>
                                <phase>prepare-package</phase>
                                <configuration>
                                    <outputDirectory>${spa.stage.dir}/crawl/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${frontend.dir}/dist/crawl-app/browser</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stage-admin-spa</id>
                                <goals><goal>copy-resources</goal></goals>
                                <phase>prepare-package</phase>
                                <configuration>
                                    <outputDirectory>${spa.stage.dir}/admin/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${frontend.dir}/dist/admin-app/browser</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
