<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.kompile</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-enforcer</artifactId>
    <name>Kompile App - LLM Judge / Enforcer</name>
    <description>
        The LLM judge/enforcer domain extracted from kompile-app-main's services package
        (ai.kompile.app.services.enforcer): the resilient judge backend, enforcement gate and fallback
        policy. Depends only on the agent module (AgentChatService / AgentRegistryService /
        ClaudeStreamParser) + kompile-utils + app-core — zero stayed-services back-edges. Package
        preserved. See docs/architecture/services-decomposition-spec.md.
    </description>

    <dependencies>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-app-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.kompile</groupId>
            <artifactId>kompile-utils</artifactId>
        </dependency>
        <!-- enforcer uses RestClient / web types for the judge backend -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <repositories>
        <!-- transitive via the agent module (pty4j → purejavacomm, published to JetBrains' repo) -->
        <repository>
            <id>intellij-dependencies</id>
            <name>JetBrains IntelliJ Dependencies</name>
            <url>https://cache-redirector.jetbrains.com/intellij-dependencies</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
</project>
