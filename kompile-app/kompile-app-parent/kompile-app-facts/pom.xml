<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>kompile-app-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kompile-app-facts</artifactId>
    <name>Kompile App - Fact-Sheet Workspace (facts / eval / sync / prompts)</name>
    <description>
        The fact-sheet workspace cluster extracted from kompile-app-main: fact sheets + notes
        (ai.kompile.app.facts), the evaluation/experiment framework (ai.kompile.app.eval), the
        markdown/note sync adapters — Notion/Obsidian/Git/local (ai.kompile.app.sync), and system
        prompt management (ai.kompile.app.prompts). These four packages are mutually coupled
        (facts↔sync, eval→facts, prompts→eval+facts), so they form a single module. The one edge
        that used to reach up into app-main (FactSheetService → services.AppIndexConfigService) is
        inverted through the FactSheetIndexConfigurer SPI declared here and implemented back in
        app-main, so this module carries no compile-time coupling into kompile-app-main.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-app-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Provides GraphBuildingConfigProvider interface from the graphs subtree.
             This module implements GraphBuildingConfigProvider so that JPA access for
             graph building config stays out of kompile-knowledge-graph ("Graphs NEVER touch JPA"). -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-knowledge-graph</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-react-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>kompile-oauth2-client</artifactId>
        </dependency>

        <!-- JPA entities + Spring Data repositories (facts/eval/sync/prompts persistence) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- RestClient + the Notion webhook @RestController in the sync package -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- SimpMessagingTemplate broadcaster (STOMP) used by the sync package -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- sync package: Obsidian vault directory watcher + Notion→Markdown (flexmark) conversion -->
        <dependency>
            <groupId>io.methvin</groupId>
            <artifactId>directory-watcher</artifactId>
            <version>0.19.0</version>
        </dependency>
        <dependency>
            <groupId>com.vladsch.flexmark</groupId>
            <artifactId>flexmark-all</artifactId>
            <version>0.64.8</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
