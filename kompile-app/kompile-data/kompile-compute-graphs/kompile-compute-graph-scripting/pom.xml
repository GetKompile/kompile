<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eclipse.deeplearning4j</groupId>
    <artifactId>kompile-compute-graphs</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>kompile-compute-graph-scripting</artifactId>
  <name>Kompile Compute Graph - Scripting Engine</name>
  <description>JVM scripting worker with GraalVM JavaScript and Python4J/system-Python execution</description>

  <properties>
    <graalvm.polyglot.version>24.1.0</graalvm.polyglot.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>kompile-cli-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>kompile-compute-graph-scripting-client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>kompile-compute-graph-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-expression</artifactId>
    </dependency>
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>polyglot</artifactId>
      <version>${graalvm.polyglot.version}</version>
    </dependency>
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>js</artifactId>
      <version>${graalvm.polyglot.version}</version>
      <type>pom</type>
    </dependency>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>python4j-core</artifactId>
      <version>${nd4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.deeplearning4j</groupId>
      <artifactId>kompile-process-engine</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>ai.kompile.compute.graph.scripting.worker.ScriptingWorkerMain</mainClass>
          <classifier>exec</classifier>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>repackage-scripting-worker</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
